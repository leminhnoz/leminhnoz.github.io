---
import { Icon } from "astro-icon/components";

import { __ } from "../utils/i18n";
import {
  SITE,
  MENU,
  BANNER,
  BANNER_SRCSET,
  TRIANGLE_BADGE,
} from "../utils/config";
import { urlFor } from "../utils/urlFor";

import HeaderLink from "./partial/HeaderLink.astro";
import RssBtn from "./partial/RssBtn";
import SearchBtn from "./partial/SearchBtn";
import ThemeBtn from "./partial/ThemeBtn";
import SearchBox from "./partial/SearchBox";

type Props = {
  title?: string;
  cover?: string;
  realm?: "programming" | "math";
};

const { title = SITE.title, cover, realm } = Astro.props;
const currentPath = Astro.url.pathname;
const isMath = realm === "math" || currentPath.startsWith("/math");

const realmMenu = isMath
  ? [
      { name: "math_home", label: "Toán học", url: "/math" },
      { name: "math_roadmap", label: "Lộ trình Toán", url: "/math/roadmap" },
      { name: "math_problems", label: "Kho bài toán", url: "/math/problems" },
      { name: "math_articles", label: "Chuyên đề", url: "/math/articles" },
      { name: "about", label: "About", url: "/about" },
    ]
  : [
      { name: "prog_home", label: "Lập trình", url: "/programming" },
      { name: "roadmap", label: "Lộ trình ICPC", url: "/roadmap" },
      { name: "problems", label: "Bài tập CP", url: "/problems" },
      { name: "archives", label: "Archives", url: "/archives" },
      { name: "about", label: "About", url: "/about" },
    ];
---

<div id="header-nav">
  <nav id="main-nav">
    {
      realmMenu.map((item) => (
        <HeaderLink href={urlFor(item.url)} aria-label={item.name}>
          {item.label}
        </HeaderLink>
      ))
    }
    <div class="nav-realm-switcher">
      {
        isMath ? (
          <a href={urlFor("programming")} class="nav-realm-pill to-prog" title="Chuyển sang phân hệ Lập trình">
            <Icon name="fa6-solid:laptop-code" size={12} />
            <span>Sang Lập trình</span>
          </a>
        ) : (
          <a href={urlFor("math")} class="nav-realm-pill to-math" title="Chuyển sang phân hệ Toán học">
            <Icon name="fa6-solid:square-root-variable" size={12} />
            <span>Sang Toán học</span>
          </a>
        )
      }
      <a href={urlFor("/")} class="nav-portal-pill" title="Quay về cổng chọn phân hệ">
        <Icon name="fa6-solid:door-open" size={12} />
        <span>Đổi phân hệ</span>
      </a>
    </div>
    <span
      id="main-nav-toggle"
      class="nav-icon"
      aria-label="Toggle navigation"
      role="button"
    >
      <Icon name="fa6-solid:bars" size={14} />
    </span>
  </nav>
  <nav id="sub-nav" aria-label="Secondary navigation">
    <RssBtn client:load href={urlFor("rss.xml")} className="nav-icon" />
    <SearchBtn client:load className="nav-icon" />
    <ThemeBtn client:load className="nav-icon" />
  </nav>
  {
    TRIANGLE_BADGE.enable && (
      <a
        href={TRIANGLE_BADGE.link}
        class="triangle-badge"
        title={TRIANGLE_BADGE.type}
        target="_blank"
        rel="noopener nofollow noreferrer"
      >
        <Icon
          name={`fa6-brands:${TRIANGLE_BADGE.type}`}
          class="triangle-badge-icon"
        />
      </a>
    )
  }
</div>
<header id="header">
  {
    cover ? (
      <img src={urlFor(cover)} alt={title} fetchpriority="high" />
    ) : BANNER_SRCSET.enable ? (
      <picture style="user-select: none;">
        {BANNER_SRCSET.srcset.map((source) => (
          <source media={source.media} srcset={urlFor(source.src)} />
        ))}
        <img src={urlFor(BANNER)} alt={title} fetchpriority="high" />
      </picture>
    ) : (
      <img src={urlFor(BANNER)} alt={title} fetchpriority="high" />
    )
  }
  <div id="header-outer" class="outer">
    <div id="header-title" class="inner">
      <slot />
    </div>
  </div>
</header>
<SearchBox
  client:idle
  searchIndexUrl={urlFor("search.json")}
  postUrlPrefix={urlFor("blog")}
  imageUrl={urlFor("images/reimu.png")}
/>

<script>
  let oldScrollTop = 0;
  window.addEventListener("scroll", () => {
    let scrollTop =
      document.documentElement.scrollTop || document.body.scrollTop;
    let diffY = scrollTop - oldScrollTop;
    window.diffY = diffY;
    oldScrollTop = scrollTop;
    if (diffY < 0) {
      document
        .getElementById("header-nav")!
        .classList.remove("header-nav-hidden");
    } else {
      document.getElementById("header-nav")!.classList.add("header-nav-hidden");
    }
  });
</script>

<style lang="stylus">
  #header-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    background: var(--color-header-background);
    box-shadow: var(--shadow-card);
    transition: background 1s, top 0.3s;
    z-index: 200;
    &.header-nav-hidden {
      top: -80px;
    }
    &:hover {
      background: rgba(255, 255, 255, 0.95);
    }
  }

  #main-nav {
    display: flex;
    align-items: center;
  }

  #header {
    min-height: 400px;
    height: 35vh;
    position: relative;

    img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 180%;
      z-index: -2;
      user-select: none;
      display: block;
      object-fit: cover;
      transition: 0.3s;
      -webkit-mask: linear-gradient(to top, transparent, #fff 50%);
      mask: linear-gradient(to top, transparent, #fff 50%);

      @media screen and (max-width: 959px) {
        height: 120%;
      }

      @media screen and (max-width: 767px) {
        height: 100%;
      }
    }
  }

  #header-outer {
    height: 100%;
    position: relative;
    max-width: 100%;
  }


  #main-nav-toggle {
    display: none;

    @media screen and (max-width: 767px) {
      display: block;
    }
  }

  :global(.nav-icon) {
    color: var(--red-0);
    opacity: 0.8;
    text-decoration: none;
    transition: 0.2s;
    padding: 20px 15px;
    text-align: center;
    font-size: 14px;
    width: 14px;
    height: 14px;
    will-change: transform;
    cursor: pointer;

    &:hover {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  :global([data-theme='dark']) {
    #header-nav:hover {
      background: var(--color-header-background);
    }

    :global(.nav-icon) {
      color: var(--red-2);
    }
  }

  #header-title {
    font-weight: 700;
    text-align: center;
    position: absolute;
    top: 50%;
    margin: 40px * -0.5 2.5% 0;
    width: 95%;
    opacity: 0;
    filter: blur(8px);
    will-change: transform, opacity, filter;
    animation: fade-in-blur 800ms ease-out 200ms forwards;
  }

  #sub-nav {
    display: flex;
    align-items: center;
  }

  @keyframes fade-in-blur {
    0% {
      opacity: 0;
      filter: blur(10px);
    }

    100% {
      opacity: 1;
      filter: blur(0);
    }
  }

  .triangle-badge {
    position: absolute;
    top: -6px;
    right: -26px;
    transform: rotate(45deg);
    width: 0;
    height: 0;
    border-left: 40px solid transparent;
    border-right: 40px solid transparent;
    border-bottom: 40px solid var(--red-2);
    display: inline-block;
    transition: 0.3s;

    @media screen and (max-width: 959px) {
      display: none;
    }
  }

  .triangle-badge-icon {
    position: absolute;
    top: 12px;
    left: -13px;
    color: var(--color-header-background) !important;
    font-size: 28px;
    transition: 0.3s;
  }
  .nav-realm-switcher {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 10px;

    @media screen and (max-width: 959px) {
      display: none;
    }
  }

  .nav-realm-pill, .nav-portal-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    border-radius: 14px;
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .nav-realm-pill.to-prog {
    background: rgba(0, 119, 182, 0.12);
    color: #0077b6;
    border: 1px solid rgba(0, 119, 182, 0.3);

    &:hover {
      background: #0096c7;
      color: #fff;
      transform: translateY(-1px);
    }
  }

  .nav-realm-pill.to-math {
    background: rgba(123, 44, 191, 0.12);
    color: #7b2cbf;
    border: 1px solid rgba(123, 44, 191, 0.3);

    &:hover {
      background: #8e24aa;
      color: #fff;
      transform: translateY(-1px);
    }
  }

  .nav-portal-pill {
    background: rgba(100, 116, 139, 0.1);
    color: var(--grey-7);
    border: 1px solid var(--color-border);

    &:hover {
      background: var(--red-1);
      color: #fff;
      border-color: var(--red-1);
      transform: translateY(-1px);
    }
  }

  :global([data-theme='dark']) {
    .nav-realm-pill.to-prog {
      background: rgba(0, 150, 199, 0.18);
      color: #80d3f2;
      border-color: rgba(0, 150, 199, 0.35);

      &:hover {
        background: #0288d1;
        color: #fff;
      }
    }
    .nav-realm-pill.to-math {
      background: rgba(186, 104, 200, 0.18);
      color: #ce93d8;
      border-color: rgba(186, 104, 200, 0.35);

      &:hover {
        background: #ab47bc;
        color: #fff;
      }
    }
  }
</style>
