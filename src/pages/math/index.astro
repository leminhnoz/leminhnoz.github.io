---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeaderTitle from "../../components/partial/HeaderTitle.astro";
import HeaderSubTitle from "../../components/partial/HeaderSubTitle.astro";
import Footer from "../../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../../utils/config";
import { urlFor } from "../../utils/urlFor";
import { formatDate } from "../../utils/formatDate";
import { readingTime } from "../../utils/wordCount";
import { sortPosts } from "../../utils/sortPosts";
import { mathRoadmapStages } from "../../data/mathRoadmap";
import { mathProblems } from "../../data/mathProblems";
import { isPureMathPost } from "../../utils/mathFilter";

const title = "Toán học";
const description = "Chuyên đề và bài tập số học, đại số, hình học phẳng và tổ hợp.";

const allPosts = await getCollection("blog");
const pureMathPosts = allPosts
  .filter(isPureMathPost)
  .sort(sortPosts);

const featuredMathPosts = pureMathPosts.slice(0, 6);
const totalRoadmapNodes = mathRoadmapStages.reduce((sum, s) => sum + s.nodes.length, 0);
---

<BaseLayout realm="math" title={`${SITE.title} | ${title}`} description={description}>
  <!-- Header -->
  <HeaderTitle title={SITE.title} url={urlFor("math")} slot="header" />
  <HeaderSubTitle
    subtitle="Olympiad Mathematics & Notes"
    url={urlFor("math")}
    slot="header"
  />

  <section id="main" aria-label="Main content">
    <div class="math-portal-wrap" data-aos="fade-up">
      <!-- Realm Switcher Bar -->
      <div class="realm-banner" data-aos="fade-down">
        <div class="realm-info">
          <span class="realm-badge">
            <Icon name="fa6-solid:square-root-variable" size={13} />
            Toán học
          </span>
          <span class="realm-desc">Số học • Đại số • Hình học • Tổ hợp</span>
        </div>
        <div class="realm-actions">
          <a href={urlFor("programming")} class="realm-switch-btn" title="Chuyển sang mục Lập trình">
            <Icon name="fa6-solid:code" size={13} />
            <span>Mục Tin</span>
          </a>
          <a href={urlFor("/")} class="realm-portal-btn" title="Quay về trang chủ">
            <Icon name="fa6-solid:door-open" size={13} />
            <span>Trang chủ</span>
          </a>
        </div>
      </div>

      <!-- Clean Minimal Header -->
      <div class="math-hero-clean" data-aos="fade-up">
        <div class="hero-left">
          <h1 class="hero-title">Toán học</h1>
          <p class="hero-desc">
            Tổng hợp chuyên đề và bài tập số học, đại số, hình học phẳng và tổ hợp.
          </p>
        </div>
        <div class="hero-stats">
          <div class="stat-pill">
            <span class="stat-val">{mathRoadmapStages.length}</span>
            <span class="stat-txt">Giai đoạn</span>
          </div>
          <div class="stat-pill">
            <span class="stat-val">{totalRoadmapNodes}</span>
            <span class="stat-txt">Chủ đề</span>
          </div>
          <div class="stat-pill">
            <span class="stat-val">{mathProblems.length}</span>
            <span class="stat-txt">Bài tập</span>
          </div>
        </div>
      </div>

      <!-- 3 Pillars (Clean Monochrome) -->
      <div class="math-pillars-grid" data-aos="fade-up">
        <!-- Pillar 1: Roadmap -->
        <a href={urlFor("math/roadmap")} class="pillar-card">
          <div class="pillar-top">
            <div class="pillar-icon">
              <Icon name="fa6-solid:route" size={18} />
            </div>
            <span class="pillar-arrow">
              <Icon name="fa6-solid:arrow-right" size={12} />
            </span>
          </div>
          <div class="pillar-content">
            <h2 class="pillar-title">Lộ trình (Roadmap)</h2>
            <p class="pillar-desc">
              Lộ trình 6 giai đoạn chuẩn bị cho các kỳ thi Olympic Toán.
            </p>
          </div>
        </a>

        <!-- Pillar 2: Problems -->
        <a href={urlFor("math/problems")} class="pillar-card">
          <div class="pillar-top">
            <div class="pillar-icon">
              <Icon name="fa6-solid:award" size={18} />
            </div>
            <span class="pillar-arrow">
              <Icon name="fa6-solid:arrow-right" size={12} />
            </span>
          </div>
          <div class="pillar-content">
            <h2 class="pillar-title">Kho đề (Problems)</h2>
            <p class="pillar-desc">
              Tuyển tập {mathProblems.length}+ bài toán Olympic chọn lọc kèm lời giải chi tiết.
            </p>
          </div>
        </a>

        <!-- Pillar 3: Articles -->
        <a href={urlFor("math/articles")} class="pillar-card">
          <div class="pillar-top">
            <div class="pillar-icon">
              <Icon name="fa6-solid:book-open" size={18} />
            </div>
            <span class="pillar-arrow">
              <Icon name="fa6-solid:arrow-right" size={12} />
            </span>
          </div>
          <div class="pillar-content">
            <h2 class="pillar-title">Chuyên đề (Articles)</h2>
            <p class="pillar-desc">
              Các bài viết lý thuyết, bổ đề và phương pháp chứng minh.
            </p>
          </div>
        </a>
      </div>

      <!-- Featured Math Articles Section -->
      <div class="featured-articles-section" data-aos="fade-up">
        <div class="section-header">
          <h2 class="section-title">Chuyên đề nổi bật</h2>
          <a href={urlFor("math/articles")} class="view-all-link">
            <span>Tất cả ({pureMathPosts.length})</span>
            <Icon name="fa6-solid:arrow-right" size={12} />
          </a>
        </div>

        <div class="featured-grid">
          {featuredMathPosts.map((post) => (
            <article class="featured-card">
              <a href={urlFor(`blog/${post.id}`)} class="card-hitbox" aria-label={post.data.title}></a>
              <div class="card-meta-line">
                <span>
                  <Icon name="fa6-solid:calendar" size={11} />
                  {formatDate(post.data.pubDate)}
                </span>
                <span>
                  <Icon name="fa6-solid:hourglass-half" size={11} />
                  {readingTime(post.body || "")} phút
                </span>
              </div>
              <h3 class="card-post-title">{post.data.title}</h3>
              <p class="card-post-excerpt">
                {post.data.excerpt || (post.body ? post.body.slice(0, 130) + "..." : "")}
              </p>
              <div class="read-link">
                <span>Đọc bài</span>
                <Icon name="fa6-solid:arrow-right" size={11} />
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer slot="footer" />
</BaseLayout>

<style lang="stylus">
  .math-portal-wrap {
    max-width: 1200px;
    margin: 0 auto 36px auto;
    padding: 0 16px;
  }

  /* Realm Switcher Bar */
  .realm-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 10px 16px;
    margin-bottom: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    gap: 12px;
    flex-wrap: wrap;
  }

  .realm-info {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .realm-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 12.5px;
    font-weight: 600;
    background: var(--color-default);
    color: var(--color-wrap);
  }

  .realm-desc {
    font-size: 13px;
    color: var(--grey-7);
  }

  .realm-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .realm-switch-btn, .realm-portal-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-border);
    background: var(--color-wrap);
    color: var(--color-default);
    transition: all 0.2s ease;

    &:hover {
      background: var(--color-border);
      transform: translateY(-1px);
    }
  }

  /* Clean Hero */
  .math-hero-clean {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    flex-wrap: wrap;
  }

  .hero-left {
    flex: 1;
    min-width: 260px;
  }

  .hero-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-default);
    margin: 0 0 6px 0;
    letter-spacing: -0.3px;
  }

  .hero-desc {
    font-size: 13.5px;
    color: var(--grey-7);
    margin: 0;
    line-height: 1.5;
  }

  .hero-stats {
    display: flex;
    gap: 8px;
  }

  .stat-pill {
    background: var(--color-border);
    border-radius: 8px;
    padding: 8px 14px;
    text-align: center;
    display: flex;
    flex-direction: column;
    min-width: 72px;

    .stat-val {
      font-size: 16px;
      font-weight: 700;
      color: var(--color-default);
      line-height: 1.2;
    }

    .stat-txt {
      font-size: 11px;
      color: var(--grey-7);
      margin-top: 2px;
    }
  }

  /* 3 Pillars Grid */
  .math-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 28px;

    @media screen and (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .pillar-card {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px 18px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;

    &:hover {
      border-color: var(--color-default);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);

      .pillar-arrow {
        transform: translateX(3px);
        color: var(--color-default);
      }
    }
  }

  .pillar-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .pillar-icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--color-border);
    color: var(--color-default);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pillar-arrow {
    color: var(--grey-7);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .pillar-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-default);
    margin: 0 0 6px 0;
  }

  .pillar-desc {
    font-size: 12.5px;
    color: var(--grey-7);
    line-height: 1.5;
    margin: 0;
  }

  /* Featured Articles Section */
  .featured-articles-section {
    margin-bottom: 30px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .section-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-default);
    margin: 0;
  }

  .view-all-link {
    font-size: 12.5px;
    color: var(--grey-7);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;

    &:hover {
      color: var(--color-default);
    }
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;

    @media screen and (max-width: 900px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media screen and (max-width: 580px) {
      grid-template-columns: 1fr;
    }
  }

  .featured-card {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 16px;
    position: relative;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    &:hover {
      border-color: var(--color-default);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);

      .read-link {
        color: var(--color-default);
        transform: translateX(2px);
      }
    }
  }

  .card-hitbox {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-meta-line {
    display: flex;
    gap: 10px;
    font-size: 11.5px;
    color: var(--grey-7);
    margin-bottom: 8px;

    span {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
  }

  .card-post-title {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-default);
    margin: 0 0 8px 0;
    line-height: 1.4;
  }

  .card-post-excerpt {
    font-size: 12.5px;
    color: var(--grey-7);
    line-height: 1.5;
    margin: 0 0 12px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-link {
    font-size: 12px;
    font-weight: 500;
    color: var(--grey-7);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.2s ease;
  }
</style>
