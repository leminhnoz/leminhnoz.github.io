---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeaderTitle from "../../components/partial/HeaderTitle.astro";
import HeaderSubTitle from "../../components/partial/HeaderSubTitle.astro";
import Footer from "../../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../../utils/config";
import { urlFor } from "../../utils/urlFor";
import { formatDate } from "../../utils/formatDate";
import { readingTime } from "../../utils/wordCount";
import { sortPosts } from "../../utils/sortPosts";
import { mathRoadmapStages } from "../../data/mathRoadmap";
import { mathProblems } from "../../data/mathProblems";

const title = "Toán Học | Mathematics Hub";
const description = "Không gian nghiên cứu và rèn luyện Toán học: Lý thuyết số, Đại số tuyến tính, Tổ hợp rời rạc, Hình học tính toán và Giải tích số.";

const mathKeywords = [
  "math", "number theory", "linear algebra", "combinatorics",
  "geometry", "convex hull", "gaussian elimination", "determinant",
  "fibonacci", "binary exponentiation", "euclidean", "diophantine"
];

const allPosts = await getCollection("blog");
const featuredMathPosts = allPosts
  .filter((post) => {
    const tags = (post.data.tags || []).map(t => t.toLowerCase());
    const cats = (post.data.categories || []).map(c => c.toLowerCase());
    const title = post.data.title.toLowerCase();
    return tags.some(t => mathKeywords.some(k => t.includes(k))) ||
           cats.some(c => mathKeywords.some(k => c.includes(k))) ||
           mathKeywords.some(k => title.includes(k));
  })
  .sort(sortPosts)
  .slice(0, 6);

const totalRoadmapNodes = mathRoadmapStages.reduce((sum, s) => sum + s.nodes.length, 0);
---

<BaseLayout realm="math" title={`${SITE.title} | ${title}`} description={description}>
  <!-- Header -->
  <HeaderTitle title={SITE.title} url={urlFor("math")} slot="header" />
  <HeaderSubTitle
    subtitle="Phân hệ Toán học • Mathematics & Theoretical Computer Science"
    url={urlFor("math")}
    slot="header"
  />

  <section id="main" aria-label="Main content">
    <div class="math-portal-wrap" data-aos="fade-up">
      <!-- Realm Switcher Bar -->
      <div class="realm-banner" data-aos="fade-down">
        <div class="realm-info">
          <span class="realm-badge active-math">
            <Icon name="fa6-solid:square-root-variable" size={14} />
            Phân hệ Toán học (Mathematics)
          </span>
          <span class="realm-desc">Lý thuyết số • Đại số ma trận • Tổ hợp • Hình học • Giải tích</span>
        </div>
        <div class="realm-actions">
          <a href={urlFor("programming")} class="realm-switch-btn" title="Chuyển sang phân hệ Lập trình">
            <Icon name="fa6-solid:laptop-code" size={14} />
            <span>Sang Lập trình</span>
          </a>
          <a href={urlFor("/")} class="realm-portal-btn" title="Quay về cổng chọn phân hệ">
            <Icon name="fa6-solid:door-open" size={14} />
            <span>Đổi phân hệ</span>
          </a>
        </div>
      </div>

      <!-- Hero Welcome Card -->
      <div class="math-hero-card" data-aos="fade-up">
        <div class="hero-left">
          <div class="hero-tag">
            <Icon name="fa6-solid:shapes" size={13} />
            <span>KHÁM PHÁ BẢN CHẤT CỦA THUẬT TOÁN</span>
          </div>
          <h1 class="hero-title">Toán Học & Nền Tảng Khoa Học Máy Tính</h1>
          <p class="hero-desc">
            Toán học không chỉ là công cụ tính toán mà là ngôn ngữ tư duy logic tối thượng.
            Mọi cấu trúc dữ liệu tinh vi, thuật toán tối ưu hay mô hình AI hiện đại đều bắt nguồn từ các định lý toán học sâu sắc.
          </p>
          <div class="hero-stats">
            <div class="hero-stat">
              <span class="num">{mathRoadmapStages.length}</span>
              <span class="lbl">Giai đoạn lộ trình</span>
            </div>
            <div class="hero-stat">
              <span class="num">{totalRoadmapNodes}</span>
              <span class="lbl">Chủ đề chuyên sâu</span>
            </div>
            <div class="hero-stat">
              <span class="num">{mathProblems.length}</span>
              <span class="lbl">Bài toán chọn lọc</span>
            </div>
          </div>
        </div>
        <div class="hero-art">
          <div class="art-ring">
            <span class="sym-art sym-1">∫</span>
            <span class="sym-art sym-2">∑</span>
            <span class="sym-art sym-3">π</span>
            <span class="sym-art sym-4">√</span>
            <span class="sym-art sym-5">∞</span>
            <Icon name="fa6-solid:infinity" size={64} class="core-math-symbol" />
          </div>
        </div>
      </div>

      <!-- 3 Main Pillars -->
      <div class="math-pillars-grid" data-aos="fade-up">
        <!-- Pillar 1: Roadmap -->
        <a href={urlFor("math/roadmap")} class="pillar-card pillar-roadmap">
          <div class="pillar-icon-box">
            <Icon name="fa6-solid:route" size={28} />
          </div>
          <div class="pillar-body">
            <span class="pillar-badge">Lộ trình học tập</span>
            <h2 class="pillar-title">Lộ Trình Toán Học (Roadmap)</h2>
            <p class="pillar-desc">
              Lộ trình 6 giai đoạn từ Lý thuyết số sơ cấp, Đại số tuyến tính, Tổ hợp rời rạc, Hình học tính toán đến Giải tích số.
            </p>
          </div>
          <div class="pillar-action">
            <span>Khám phá Lộ trình Toán</span>
            <Icon name="fa6-solid:arrow-right" size={14} />
          </div>
        </a>

        <!-- Pillar 2: Problems -->
        <a href={urlFor("math/problems")} class="pillar-card pillar-problems">
          <div class="pillar-icon-box">
            <Icon name="fa6-solid:calculator" size={28} />
          </div>
          <div class="pillar-body">
            <span class="pillar-badge">Luyện tập thực chiến</span>
            <h2 class="pillar-title">Kho Bài Toán (Problems)</h2>
            <p class="pillar-desc">
              Tuyển chọn 33+ bài toán kinh điển từ Project Euler, CSES Math Set, Codeforces và VNOJ có link nộp bài trực tiếp.
            </p>
          </div>
          <div class="pillar-action">
            <span>Vào Kho Bài Toán</span>
            <Icon name="fa6-solid:arrow-right" size={14} />
          </div>
        </a>

        <!-- Pillar 3: Articles -->
        <a href={urlFor("math/articles")} class="pillar-card pillar-articles">
          <div class="pillar-icon-box">
            <Icon name="fa6-solid:book-open" size={28} />
          </div>
          <div class="pillar-body">
            <span class="pillar-badge">Bài giảng & Bổ đề</span>
            <h2 class="pillar-title">Chuyên Đề Toán (Articles)</h2>
            <p class="pillar-desc">
              Các bài phân tích toán học chuyên sâu: Khử Gauss, Định thức ma trận, Lũy thừa nhị phân, Euclid mở rộng, Fibonacci secrets.
            </p>
          </div>
          <div class="pillar-action">
            <span>Đọc các Chuyên đề</span>
            <Icon name="fa6-solid:arrow-right" size={14} />
          </div>
        </a>
      </div>

      <!-- Featured Math Articles Section -->
      <div class="featured-articles-section" data-aos="fade-up">
        <div class="section-header">
          <div>
            <h2 class="section-title">
              <Icon name="fa6-solid:fire" size={20} class="flame-icon" />
              Chuyên đề Toán học nổi bật
            </h2>
            <span class="section-sub">Các bài viết có mã nguồn C++ mẫu và chứng minh chặt chẽ</span>
          </div>
          <a href={urlFor("math/articles")} class="view-all-link">
            <span>Xem tất cả ({allPosts.length})</span>
            <Icon name="fa6-solid:arrow-right" size={12} />
          </a>
        </div>

        <div class="featured-grid">
          {featuredMathPosts.map((post) => (
            <article class="featured-card">
              <a href={urlFor(`blog/${post.id}`)} class="card-hitbox" aria-label={post.data.title}></a>
              <div class="card-meta-line">
                <span>
                  <Icon name="fa6-solid:calendar" size={11} />
                  {formatDate(post.data.pubDate)}
                </span>
                <span>
                  <Icon name="fa6-solid:hourglass-half" size={11} />
                  {readingTime(post.body || "")} phút
                </span>
              </div>
              <h3 class="card-post-title">{post.data.title}</h3>
              <p class="card-post-excerpt">
                {post.data.excerpt || (post.body ? post.body.slice(0, 140) + "..." : "")}
              </p>
              <div class="read-link">
                <span>Chi tiết chuyên đề</span>
                <Icon name="fa6-solid:arrow-right" size={11} />
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Mathematical Philosophy Box -->
      <div class="math-quote-box" data-aos="fade-up">
        <blockquote class="quote-text">
          "Pure mathematics is, in its way, the poetry of logical ideas."
        </blockquote>
        <cite class="quote-author">— Albert Einstein</cite>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer slot="footer" />
</BaseLayout>

<style lang="stylus">
  .math-portal-wrap {
    max-width: 1200px;
    margin: 0 auto 36px auto;
    padding: 0 16px;
  }

  /* Realm Switcher Bar */
  .realm-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 12px 20px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-card);
    flex-wrap: wrap;
    gap: 12px;
  }

  .realm-info {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .realm-badge.active-math {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    background: linear-gradient(135deg, #7b2cbf, #9d4edd);
    color: #fff;
    box-shadow: 0 2px 10px rgba(157, 78, 221, 0.35);
  }

  .realm-desc {
    font-size: 13px;
    color: var(--grey-7);
  }

  .realm-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .realm-switch-btn, .realm-portal-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 10px;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .realm-switch-btn {
    background: rgba(0, 119, 182, 0.1);
    color: #0077b6;
    border: 1px solid rgba(0, 119, 182, 0.25);

    &:hover {
      background: #0096c7;
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(0, 150, 199, 0.3);
    }
  }

  .realm-portal-btn {
    background: rgba(100, 116, 139, 0.1);
    color: var(--grey-7);
    border: 1px solid var(--color-border);

    &:hover {
      background: var(--red-1);
      color: #fff;
      border-color: var(--red-1);
      transform: translateY(-1px);
    }
  }

  /* Hero Card */
  .math-hero-card {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 40px 36px;
    margin-bottom: 32px;
    box-shadow: var(--shadow-card);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    position: relative;
    overflow: hidden;

    @media screen and (max-width: 860px) {
      flex-direction: column;
      padding: 28px 20px;
    }
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: rgba(123, 44, 191, 0.12);
    color: #7b2cbf;
    border: 1px solid rgba(123, 44, 191, 0.25);
    margin-bottom: 12px;
  }

  .hero-title {
    font-size: 28px;
    font-weight: 800;
    color: var(--color-default);
    margin: 0 0 12px 0;
    line-height: 1.35;
  }

  .hero-desc {
    font-size: 15px;
    color: var(--grey-7);
    line-height: 1.65;
    margin: 0 0 24px 0;
    max-width: 640px;
  }

  .hero-stats {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;

    .num {
      font-size: 26px;
      font-weight: 800;
      color: #7b2cbf;
    }
    .lbl {
      font-size: 12px;
      color: var(--grey-7);
    }
  }

  .hero-art {
    flex-shrink: 0;
  }

  .art-ring {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(123, 44, 191, 0.15) 0%, rgba(157, 78, 221, 0.05) 70%);
    border: 2px dashed rgba(157, 78, 221, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: #7b2cbf;
    animation: rotateSlow 40s linear infinite;
  }

  @keyframes rotateSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .core-math-symbol {
    animation: counterRotate 40s linear infinite;
  }

  @keyframes counterRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(-360deg); }
  }

  .sym-art {
    position: absolute;
    font-weight: 700;
    color: #9d4edd;
    opacity: 0.6;

    &.sym-1 { top: 10px; left: 24px; font-size: 18px; }
    &.sym-2 { top: 12px; right: 28px; font-size: 20px; }
    &.sym-3 { bottom: 16px; left: 24px; font-size: 16px; }
    &.sym-4 { bottom: 18px; right: 28px; font-size: 18px; }
    &.sym-5 { top: 50%; right: 6px; transform: translateY(-50%); font-size: 16px; }
  }

  /* 3 Main Pillars */
  .math-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 36px;

    @media screen and (max-width: 959px) {
      grid-template-columns: 1fr;
    }
  }

  .pillar-card {
    background: var(--color-wrap);
    border: 2px solid var(--color-border);
    border-radius: 20px;
    padding: 28px 24px;
    box-shadow: var(--shadow-card);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);

    &:hover {
      transform: translateY(-6px);
      border-color: #7b2cbf;
      box-shadow: 0 16px 36px rgba(123, 44, 191, 0.2);

      .pillar-action {
        color: #7b2cbf;
        transform: translateX(4px);
      }
      .pillar-icon-box {
        transform: scale(1.08);
      }
    }
  }

  .pillar-icon-box {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: rgba(123, 44, 191, 0.1);
    color: #7b2cbf;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    transition: transform 0.25s ease;
  }

  .pillar-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #7b2cbf;
    margin-bottom: 6px;
  }

  .pillar-title {
    font-size: 19px;
    font-weight: 700;
    color: var(--color-default);
    margin: 0 0 10px 0;
  }

  .pillar-desc {
    font-size: 13.5px;
    color: var(--grey-7);
    line-height: 1.6;
    margin: 0 0 20px 0;
  }

  .pillar-action {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--grey-7);
    transition: all 0.2s ease;
  }

  /* Featured Articles Grid */
  .featured-articles-section {
    margin-bottom: 36px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .section-title {
    font-size: 21px;
    font-weight: 700;
    color: var(--color-default);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 4px 0;
  }

  .flame-icon {
    color: #e67e22;
  }

  .section-sub {
    font-size: 13px;
    color: var(--grey-7);
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #7b2cbf;
    text-decoration: none;
    transition: all 0.2s ease;

    &:hover {
      color: #9d4edd;
      transform: translateX(2px);
    }
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .featured-card {
    position: relative;
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 22px;
    box-shadow: var(--shadow-card);
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    &:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-card-hover);
      border-color: rgba(123, 44, 191, 0.35);

      .card-post-title { color: #7b2cbf; }
      .read-link { color: #7b2cbf; transform: translateX(3px); }
    }
  }

  .card-hitbox {
    position: absolute;
    inset: 0;
    z-index: 5;
  }

  .card-meta-line {
    display: flex;
    gap: 12px;
    font-size: 11.5px;
    color: var(--grey-7);
    margin-bottom: 8px;

    span {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
  }

  .card-post-title {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--color-default);
    margin: 0 0 8px 0;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .card-post-excerpt {
    font-size: 13px;
    color: var(--grey-7);
    line-height: 1.55;
    margin: 0 0 14px 0;
    flex-grow: 1;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--grey-7);
    transition: all 0.2s ease;
  }

  /* Quote Box */
  .math-quote-box {
    background: var(--color-wrap);
    border-left: 4px solid #7b2cbf;
    border-radius: 0 14px 14px 0;
    padding: 22px 26px;
    box-shadow: var(--shadow-card);
  }

  .quote-text {
    margin: 0 0 8px 0;
    font-size: 15.5px;
    font-style: italic;
    color: var(--color-default);
    line-height: 1.6;
  }

  .quote-author {
    font-size: 13px;
    font-weight: 600;
    color: var(--grey-7);
    display: block;
  }

  :global([data-theme='dark']) {
    .realm-badge.active-math {
      background: linear-gradient(135deg, #8e24aa, #ba68c8);
    }
    .hero-stat .num { color: #ce93d8; }
    .art-ring {
      background: radial-gradient(circle, rgba(186, 104, 200, 0.2) 0%, transparent 70%);
      border-color: rgba(186, 104, 200, 0.4);
      color: #ce93d8;
    }
    .sym-art { color: #ce93d8; }
    .pillar-icon-box {
      background: rgba(186, 104, 200, 0.15);
      color: #ce93d8;
    }
    .pillar-badge { color: #ce93d8; }
    .pillar-card:hover {
      border-color: #ce93d8;
      .pillar-action { color: #ce93d8; }
    }
    .view-all-link { color: #ce93d8; }
    .featured-card:hover {
      border-color: rgba(186, 104, 200, 0.4);
      .card-post-title { color: #ce93d8; }
      .read-link { color: #ce93d8; }
    }
    .math-quote-box {
      border-left-color: #ab47bc;
    }
  }
</style>
