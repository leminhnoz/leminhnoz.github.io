---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeaderTitle from "../../components/partial/HeaderTitle.astro";
import HeaderSubTitle from "../../components/partial/HeaderSubTitle.astro";
import Footer from "../../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../../utils/config";
import { urlFor } from "../../utils/urlFor";
import { formatDate } from "../../utils/formatDate";
import { readingTime } from "../../utils/wordCount";
import { sortPosts } from "../../utils/sortPosts";
import { mathRoadmapStages } from "../../data/mathRoadmap";
import { mathProblems } from "../../data/mathProblems";
import { isPureMathPost } from "../../utils/mathFilter";

const title = "Toán Học Olympic | Mathematical Olympiad Hub";
const description = "Không gian Toán học Olympic: IMO, VMO, USAMO, Putnam • Tứ trụ Olympic: Số học, Đại số & PT hàm, Hình học phẳng, Tổ hợp & Đồ thị • Độc lập hoàn toàn với Tin học.";

const allPosts = await getCollection("blog");
const pureMathPosts = allPosts
  .filter(isPureMathPost)
  .sort(sortPosts);

const featuredMathPosts = pureMathPosts.slice(0, 6);

const totalRoadmapNodes = mathRoadmapStages.reduce((sum, s) => sum + s.nodes.length, 0);
---

<BaseLayout realm="math" title={`${SITE.title} | ${title}`} description={description}>
  <!-- Header -->
  <HeaderTitle title={SITE.title} url={urlFor("math")} slot="header" />
  <HeaderSubTitle
    subtitle="Phân hệ Toán học Olympic • IMO • VMO • USAMO • Putnam"
    url={urlFor("math")}
    slot="header"
  />

  <section id="main" aria-label="Main content">
    <div class="math-portal-wrap" data-aos="fade-up">
      <!-- Realm Switcher Bar -->
      <div class="realm-banner" data-aos="fade-down">
        <div class="realm-info">
          <span class="realm-badge active-math">
            <Icon name="fa6-solid:award" size={14} />
            Phân hệ Toán Olympic (Pure Mathematics)
          </span>
          <span class="realm-desc">Số học (NT) • Đại số & PT hàm • Hình học phẳng • Tổ hợp (COMB) • Bất đẳng thức</span>
        </div>
        <div class="realm-actions">
          <a href={urlFor("programming")} class="realm-switch-btn" title="Chuyển sang phân hệ Lập trình">
            <Icon name="fa6-solid:laptop-code" size={14} />
            <span>Sang Lập trình</span>
          </a>
          <a href={urlFor("/")} class="realm-portal-btn" title="Quay về cổng chọn phân hệ">
            <Icon name="fa6-solid:door-open" size={14} />
            <span>Đổi phân hệ</span>
          </a>
        </div>
      </div>

      <!-- Hero Welcome Card -->
      <div class="math-hero-card" data-aos="fade-up">
        <div class="hero-left">
          <div class="hero-tag">
            <Icon name="fa6-solid:shapes" size={13} />
            <span>ĐỘC LẬP HOÀN TOÀN VỚI TIN HỌC • TƯ DUY SUY LUẬN THUẦN TÚY</span>
          </div>
          <h1 class="hero-title">Toán Học Olympic & Nghệ Thuật Chứng Minh</h1>
          <p class="hero-desc">
            Không lập trình, không thuật toán máy tính — nơi đây dành riêng cho vẻ đẹp thuần khiết của <strong>Toán học Olympic</strong>. 
            Từ những bài toán số học huyền thoại của IMO, phương trình hàm trừu tượng, hình học xạ ảnh điều hòa đến tổ hợp rời rạc và các bài thi VMO, USAMO, Putnam danh giá.
          </p>
          <div class="hero-stats">
            <div class="hero-stat">
              <span class="num">{mathRoadmapStages.length}</span>
              <span class="lbl">Giai đoạn Olympic</span>
            </div>
            <div class="hero-stat">
              <span class="num">{totalRoadmapNodes}</span>
              <span class="lbl">Chuyên đề & Bổ đề</span>
            </div>
            <div class="hero-stat">
              <span class="num">{mathProblems.length}</span>
              <span class="lbl">Bài thi IMO/VMO chọn lọc</span>
            </div>
          </div>
        </div>
        <div class="hero-art">
          <div class="art-ring">
            <span class="sym-art sym-1">∫</span>
            <span class="sym-art sym-2">∑</span>
            <span class="sym-art sym-3">π</span>
            <span class="sym-art sym-4">√</span>
            <span class="sym-art sym-5">∞</span>
            <Icon name="fa6-solid:infinity" size={64} class="core-math-symbol" />
          </div>
        </div>
      </div>

      <!-- 3 Main Pillars -->
      <div class="math-pillars-grid" data-aos="fade-up">
        <!-- Pillar 1: Roadmap -->
        <a href={urlFor("math/roadmap")} class="pillar-card pillar-roadmap">
          <div class="pillar-icon-box">
            <Icon name="fa6-solid:route" size={28} />
          </div>
          <div class="pillar-body">
            <span class="pillar-badge">Lộ trình học tập</span>
            <h2 class="pillar-title">Lộ Trình IMO / VMO (Roadmap)</h2>
            <p class="pillar-desc">
              Hệ thống 6 giai đoạn chuẩn thi Olympic: Số học (LTE, Vieta Jumping), Đại số & PT hàm, Hình học phẳng (Hàng điều hòa, Pascal), Tổ hợp cực hạn và BĐT.
            </p>
          </div>
          <div class="pillar-action">
            <span>Khám phá Lộ trình Toán</span>
            <Icon name="fa6-solid:arrow-right" size={14} />
          </div>
        </a>

        <!-- Pillar 2: Problems -->
        <a href={urlFor("math/problems")} class="pillar-card pillar-problems">
          <div class="pillar-icon-box">
            <Icon name="fa6-solid:award" size={28} />
          </div>
          <div class="pillar-body">
            <span class="pillar-badge">Đề thi kinh điển</span>
            <h2 class="pillar-title">Kho Đề Olympic (Problems)</h2>
            <p class="pillar-desc">
              Tuyển tập {mathProblems.length}+ bài toán kinh điển từ IMO, VMO, USAMO, Putnam, RMM với đề bài chi tiết trực tiếp, công thức KaTeX chuẩn mực và gợi ý phương pháp giải tại chỗ.
            </p>
          </div>
          <div class="pillar-action">
            <span>Vào Kho Đề Olympic</span>
            <Icon name="fa6-solid:arrow-right" size={14} />
          </div>
        </a>

        <!-- Pillar 3: Articles -->
        <a href={urlFor("math/articles")} class="pillar-card pillar-articles">
          <div class="pillar-icon-box">
            <Icon name="fa6-solid:book-open" size={28} />
          </div>
          <div class="pillar-body">
            <span class="pillar-badge">Bài giảng & Bổ đề</span>
            <h2 class="pillar-title">Chuyên Đề Toán (Articles)</h2>
            <p class="pillar-desc">
              Các bài phân tích chuyên sâu: Bổ đề Bézout, Bổ đề LTE, Vieta Jumping, Hàng điểm điều hòa, Bất đẳng thức SOS và Phương trình hàm IMO.
            </p>
          </div>
          <div class="pillar-action">
            <span>Đọc các Chuyên đề</span>
            <Icon name="fa6-solid:arrow-right" size={14} />
          </div>
        </a>
      </div>

      <!-- Featured Math Articles Section -->
      <div class="featured-articles-section" data-aos="fade-up">
        <div class="section-header">
          <div>
            <h2 class="section-title">
              <Icon name="fa6-solid:fire" size={20} class="flame-icon" />
              Chuyên đề Toán học nổi bật
            </h2>
            <span class="section-sub">Các bài viết có chứng minh chặt chẽ và công thức KaTeX chi tiết</span>
          </div>
          <a href={urlFor("math/articles")} class="view-all-link">
            <span>Xem tất cả ({pureMathPosts.length})</span>
            <Icon name="fa6-solid:arrow-right" size={12} />
          </a>
        </div>

        <div class="featured-grid">
          {featuredMathPosts.map((post) => (
            <article class="featured-card">
              <a href={urlFor(`blog/${post.id}`)} class="card-hitbox" aria-label={post.data.title}></a>
              <div class="card-meta-line">
                <span>
                  <Icon name="fa6-solid:calendar" size={11} />
                  {formatDate(post.data.pubDate)}
                </span>
                <span>
                  <Icon name="fa6-solid:hourglass-half" size={11} />
                  {readingTime(post.body || "")} phút
                </span>
              </div>
              <h3 class="card-post-title">{post.data.title}</h3>
              <p class="card-post-excerpt">
                {post.data.excerpt || (post.body ? post.body.slice(0, 140) + "..." : "")}
              </p>
              <div class="read-link">
                <span>Chi tiết chuyên đề</span>
                <Icon name="fa6-solid:arrow-right" size={11} />
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Mathematical Philosophy Box -->
      <div class="math-quote-box" data-aos="fade-up">
        <blockquote class="quote-text">
          "Pure mathematics is, in its way, the poetry of logical ideas."
        </blockquote>
        <cite class="quote-author">— Albert Einstein</cite>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer slot="footer" />
</BaseLayout>

<style lang="stylus">
  .math-portal-wrap {
    max-width: 1200px;
    margin: 0 auto 36px auto;
    padding: 0 16px;
  }

  /* Realm Switcher Bar */
  .realm-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 12px 20px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-card);
    gap: 16px;
    flex-wrap: wrap;
  }

  .realm-info {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .realm-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;

    &.active-math {
      background: rgba(123, 44, 191, 0.12);
      color: #7b2cbf;
      border: 1px solid rgba(123, 44, 191, 0.25);
    }
  }

  .realm-desc {
    font-size: 12.5px;
    color: var(--grey-7);
    font-weight: 500;
  }

  .realm-actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .realm-switch-btn, .realm-portal-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 10px;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .realm-switch-btn {
    background: rgba(30, 144, 255, 0.1);
    color: #1e90ff;
    border: 1px solid rgba(30, 144, 255, 0.25);

    &:hover {
      background: #1e90ff;
      color: #fff;
      transform: translateY(-1px);
    }
  }

  .realm-portal-btn {
    background: transparent;
    color: var(--grey-7);
    border: 1px solid var(--color-border);

    &:hover {
      border-color: #7b2cbf;
      color: #7b2cbf;
    }
  }

  /* Hero Welcome Card */
  .math-hero-card {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 38px 36px;
    margin-bottom: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-card);

    &::before {
      content: '';
      position: absolute;
      top: -60px;
      right: -60px;
      width: 240px;
      height: 240px;
      background: radial-gradient(circle, rgba(123, 44, 191, 0.12) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }
  }

  .hero-left {
    flex: 1;
    max-width: 680px;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: rgba(123, 44, 191, 0.12);
    color: #7b2cbf;
    border: 1px solid rgba(123, 44, 191, 0.25);
    margin-bottom: 14px;
  }

  .hero-title {
    font-size: 28px;
    font-weight: 800;
    color: var(--color-default);
    margin: 0 0 12px 0;
    line-height: 1.25;
  }

  .hero-desc {
    font-size: 15px;
    line-height: 1.65;
    color: var(--grey-7);
    margin: 0 0 24px 0;

    strong {
      color: var(--color-default);
    }
  }

  .hero-stats {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;

    .num {
      font-size: 26px;
      font-weight: 800;
      color: #7b2cbf;
      line-height: 1;
    }
    .lbl {
      font-size: 12px;
      color: var(--grey-7);
      font-weight: 500;
    }
  }

  .hero-art {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-right: 20px;

    @media (max-width: 768px) {
      display: none;
    }
  }

  .art-ring {
    position: relative;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 2px dashed rgba(123, 44, 191, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: rotateSlow 40s linear infinite;
  }

  @keyframes rotateSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .core-math-symbol {
    color: #7b2cbf;
    opacity: 0.9;
    animation: pulseSymbol 3s ease-in-out infinite alternate;
  }

  @keyframes pulseSymbol {
    from { transform: scale(0.92); opacity: 0.75; }
    to { transform: scale(1.05); opacity: 1; }
  }

  .sym-art {
    position: absolute;
    font-size: 18px;
    font-weight: 800;
    color: #7b2cbf;
    opacity: 0.7;

    &.sym-1 { top: -10px; left: 58px; }
    &.sym-2 { top: 40px; right: -12px; }
    &.sym-3 { bottom: -10px; right: 52px; }
    &.sym-4 { bottom: 40px; left: -10px; }
    &.sym-5 { top: 18px; left: 10px; }
  }

  /* 3 Pillars Grid */
  .math-pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 22px;
    margin-bottom: 34px;
  }

  .pillar-card {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 26px 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;

    &:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-card-hover);
      border-color: rgba(123, 44, 191, 0.4);

      .pillar-action {
        color: #7b2cbf;
        transform: translateX(4px);
      }
    }
  }

  .pillar-icon-box {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    background: rgba(123, 44, 191, 0.1);
    color: #7b2cbf;
  }

  .pillar-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #7b2cbf;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }

  .pillar-title {
    font-size: 19px;
    font-weight: 800;
    color: var(--color-default);
    margin: 0 0 8px 0;
  }

  .pillar-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--grey-7);
    margin: 0 0 20px 0;
  }

  .pillar-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-default);
    transition: all 0.2s ease;
  }

  /* Featured Articles Section */
  .featured-articles-section {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 30px 28px;
    margin-bottom: 30px;
    box-shadow: var(--shadow-card);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 22px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
    gap: 12px;
  }

  .section-title {
    font-size: 20px;
    font-weight: 800;
    color: var(--color-default);
    margin: 0 0 4px 0;
    display: flex;
    align-items: center;
    gap: 8px;

    .flame-icon {
      color: #e67e22;
    }
  }

  .section-sub {
    font-size: 13px;
    color: var(--grey-7);
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #7b2cbf;
    text-decoration: none;
    transition: transform 0.2s ease;

    &:hover {
      transform: translateX(3px);
    }
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .featured-card {
    background: rgba(53, 90, 117, 0.04);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 20px;
    position: relative;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    &:hover {
      transform: translateY(-3px);
      border-color: rgba(123, 44, 191, 0.35);
      background: var(--color-wrap);
      box-shadow: var(--shadow-card);

      .read-link {
        color: #7b2cbf;
        transform: translateX(4px);
      }
    }
  }

  .card-hitbox {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-meta-line {
    display: flex;
    gap: 12px;
    font-size: 11.5px;
    color: var(--grey-7);
    margin-bottom: 8px;

    span {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
  }

  .card-post-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-default);
    margin: 0 0 8px 0;
    line-height: 1.4;
  }

  .card-post-excerpt {
    font-size: 13px;
    color: var(--grey-7);
    line-height: 1.5;
    margin: 0 0 16px 0;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-default);
    transition: all 0.2s ease;
  }

  /* Mathematical Quote Box */
  .math-quote-box {
    background: linear-gradient(135deg, rgba(123, 44, 191, 0.08) 0%, rgba(157, 78, 221, 0.03) 100%);
    border: 1px solid rgba(123, 44, 191, 0.2);
    border-radius: 16px;
    padding: 28px 24px;
    text-align: center;
    box-shadow: var(--shadow-card);
  }

  .quote-text {
    font-size: 17px;
    font-style: italic;
    color: var(--color-default);
    margin: 0 0 8px 0;
    line-height: 1.5;
    font-weight: 500;
  }

  .quote-author {
    font-size: 13px;
    color: #7b2cbf;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  :global([data-theme='dark']) {
    .math-badge, .hero-tag, .pillar-badge {
      background: rgba(186, 104, 200, 0.15);
      color: #ce93d8;
    }
    .hero-stat .num { color: #ce93d8; }
    .core-math-symbol { color: #ce93d8; }
    .art-ring { border-color: rgba(186, 104, 200, 0.3); }
    .sym-art { color: #ce93d8; }
    .pillar-icon-box {
      background: rgba(186, 104, 200, 0.15);
      color: #ce93d8;
    }
    .view-all-link { color: #ce93d8; }
    .quote-author { color: #ce93d8; }
  }
</style>
