---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HeaderTitle from "../../../components/partial/HeaderTitle.astro";
import HeaderSubTitle from "../../../components/partial/HeaderSubTitle.astro";
import Footer from "../../../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { urlFor } from "../../../utils/urlFor";
import { mathRoadmapStages } from "../../../data/mathRoadmap";
import { renderFormula, renderMathInText } from "../../../utils/renderMath";
import "katex/dist/katex.min.css";

const title = "Lộ trình Toán học";
const description = "Lộ trình 6 giai đoạn: Số học, Đại số, Hình học, Tổ hợp, Bất đẳng thức và Olympic Sinh viên.";

const totalStages = mathRoadmapStages.length;
const totalNodes = mathRoadmapStages.reduce((sum, s) => sum + s.nodes.length, 0);
const completedNodes = mathRoadmapStages.reduce(
  (sum, s) => sum + s.nodes.filter(n => n.blogSlug !== null).length,
  0
);
---

<BaseLayout realm="math" title={title} description={description}>
  <HeaderTitle title="Math Roadmap" url={urlFor("math/roadmap")} slot="header" />
  <HeaderSubTitle
    subtitle="Lộ trình học Toán: Số học • Đại số • Hình học • Tổ hợp"
    url={urlFor("math/roadmap")}
    slot="header"
  />

  <section id="main" aria-label="Main content">
    <div class="roadmap-wrapper" data-aos="fade-up">
      <!-- Intro Header -->
      <header class="roadmap-intro">
        <div class="intro-content">
          <div class="math-badge">
            <Icon name="fa6-solid:route" size={13} />
            <span>Lộ trình học tập</span>
          </div>
          <h1 class="page-title">{title}</h1>
          <p class="page-description">{description}</p>
        </div>
        <div class="intro-stats">
          <div class="stats-badge">
            <span class="stats-number">{totalStages}</span> Giai đoạn
          </div>
          <div class="stats-badge">
            <span class="stats-number">{totalNodes}</span> Chuyên đề
          </div>
          <div class="stats-badge highlight">
            <span class="stats-number">{completedNodes}</span> Đã có Blog
          </div>
        </div>
      </header>

      <!-- Toolbar -->
      <div class="roadmap-toolbar">
        <div class="filter-group" role="tablist">
          <button class="filter-btn active" data-filter="all" type="button">Tất cả ({totalNodes})</button>
          <button class="filter-btn" data-filter="has_blog" type="button">Đã có Blog ({completedNodes})</button>
          <button class="filter-btn" data-filter="advanced" type="button">Nâng cao TST & IMO</button>
        </div>
        <div class="quick-jump">
          <select id="stage-select" class="stage-dropdown" aria-label="Nhảy tới giai đoạn hoặc nhóm chủ đề">
            <option value="">-- Chọn Giai đoạn / Nhóm chủ đề --</option>
            {mathRoadmapStages.map(stage => (
              <optgroup label={stage.name}>
                <option value={`stage-${stage.id}`}>Toàn bộ {stage.name}</option>
                {stage.groups.map(g => (
                  <option value={g.id}>↳ Bước {g.stepNumber}: {g.title}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>
      </div>

      <!-- Stages List -->
      <div class="stages-container">
        {mathRoadmapStages.map((stage) => (
          <section id={`stage-${stage.id}`} class="stage-section" data-aos="fade-up">
            <header class="stage-header">
              <div class="stage-title-wrap">
                <span class="stage-icon">
                  <Icon name={stage.icon} size={22} />
                </span>
                <div>
                  <h2 class="stage-name">{stage.name}</h2>
                  <span class="stage-subtitle">{stage.subtitle}</span>
                </div>
              </div>
              <p class="stage-desc">{stage.description}</p>

              <!-- Stage Stepper Track (Lộ trình từ từ) -->
              <div class="stage-stepper-wrap">
                <div class="stepper-label">
                  <Icon name="fa6-solid:route" size={13} />
                  <span>Lộ trình các bước học tập</span>
                </div>
                <div class="stepper-track">
                  {stage.groups.map((group, gIdx) => (
                    <a href={`#${group.id}`} class="stepper-node" title={group.description}>
                      <span class="stepper-badge">{group.stepNumber}</span>
                      <div class="stepper-info">
                        <span class="stepper-level">{group.levelBadge}</span>
                        <span class="stepper-name">{group.title}</span>
                      </div>
                      {gIdx < stage.groups.length - 1 && (
                        <span class="stepper-arrow">
                          <Icon name="fa6-solid:arrow-right" size={11} />
                        </span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            </header>

            <!-- Groups in this Stage -->
            <div class="groups-container">
              {stage.groups.map((group) => {
                const groupNodes = stage.nodes.filter(n => group.nodeIds.includes(n.id));
                return (
                  <section id={group.id} class="roadmap-group-card">
                    <div class="group-header">
                      <div class="group-badge-line">
                        <span class="group-step-pill">BƯỚC {group.stepNumber}</span>
                        <span class="group-level-pill">{group.levelBadge}</span>
                      </div>
                      <h3 class="group-title">{group.title}</h3>
                      <p class="group-guide">{group.description}</p>
                    </div>

                    <div class="nodes-grid">
                      {groupNodes.map((node, nIdx) => {
                        const diffClass = node.difficulty
                          .toLowerCase()
                          .normalize("NFD")
                          .replace(/[\u0300-\u036f]/g, "")
                          .replace(/\s+/g, "-");
                        return (
                          <article
                            class="node-card"
                            data-status={node.status}
                            data-has-blog={node.blogSlug ? "true" : "false"}
                            data-difficulty={node.difficulty}
                          >
                            <div class="node-header">
                              <span class="node-step-tag">#{group.stepNumber}.{nIdx + 1}</span>
                              <span class={`difficulty-badge ${diffClass}`}>
                                {node.difficulty}
                              </span>
                              <span class={`status-badge ${node.status}`}>
                                {node.blogSlug ? "Đã có Chuyên đề" : "Đang biên soạn"}
                              </span>
                            </div>

                            <h4 class="node-title" set:html={renderMathInText(node.title)} />
                            <div class="node-vietnamese-title" set:html={renderMathInText(node.vietnameseTitle)} />
                            <div class="node-desc" set:html={renderMathInText(node.description)} />

                            <!-- Key Formula Box -->
                            <div class="formula-box">
                              <span class="formula-label">Công thức then chốt:</span>
                              <div class="formula-rendered" set:html={renderFormula(node.latexFormula, true)} />
                            </div>

                            <!-- Key Theorems -->
                            <div class="theorems-block">
                              <span class="sub-label">Định lý cốt lõi:</span>
                              <ul class="theorems-list">
                                {node.keyTheorems.map((thm) => (
                                  <li><span class="bullet">▹</span> <span set:html={renderMathInText(thm)} /></li>
                                ))}
                              </ul>
                            </div>

                            <!-- Practice Problems -->
                            {node.practiceProblems.length > 0 && (
                              <div class="problems-block">
                                <span class="sub-label">Bài toán Olympic thực tế:</span>
                                <div class="problem-chips">
                                  {node.practiceProblems.map((prob) => {
                                    const searchKeyword = prob.title.split(':')[0].trim();
                                    return (
                                      <a
                                        href={urlFor(`math/problems?search=${encodeURIComponent(searchKeyword)}`)}
                                        class={`prob-chip ${prob.judge.toLowerCase().replace(/\s+/g, '-')}`}
                                        title={`Xem đề bài chi tiết & phương pháp giải của ${prob.title} trong Kho đề Olympic`}
                                      >
                                        <span class="judge-tag">{prob.judge}</span>
                                        <span class="prob-title">{prob.title}</span>
                                        <Icon name="fa6-solid:arrow-right" size={9} />
                                      </a>
                                    );
                                  })}
                                </div>
                              </div>
                            )}

                            <!-- Footer: Link to Blog -->
                            <div class="node-footer">
                              {node.blogSlug ? (
                                <a href={urlFor(`blog/${node.blogSlug}`)} class="blog-link active">
                                  <Icon name="fa6-solid:book-open" size={13} />
                                  <span>Đọc bài giảng chi tiết</span>
                                  <Icon name="fa6-solid:arrow-right" size={11} />
                                </a>
                              ) : (
                                <span class="blog-link pending">
                                  <Icon name="fa6-solid:pen" size={13} />
                                  <span>Chuyên đề đang được hoàn thiện</span>
                                </span>
                              )}
                            </div>
                          </article>
                        );
                      })}
                    </div>
                  </section>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function setupRoadmapInteractions() {
    // Stage Quick Jump
    const stageSelect = document.getElementById('stage-select') as HTMLSelectElement | null;
    if (stageSelect) {
      stageSelect.addEventListener('change', (e) => {
        const targetId = (e.target as HTMLSelectElement).value;
        if (targetId) {
          const el = document.getElementById(targetId);
          if (el) {
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    }

    // Filter Buttons
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.node-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        cards.forEach((card) => {
          const hasBlog = card.getAttribute('data-has-blog') === 'true';
          const diff = card.getAttribute('data-difficulty') || '';

          if (filter === 'all') {
            card.style.display = 'flex';
          } else if (filter === 'has_blog') {
            card.style.display = hasBlog ? 'flex' : 'none';
          } else if (filter === 'advanced') {
            card.style.display = (diff.includes('TST') || diff.includes('IMO') || diff.includes('VMO')) ? 'flex' : 'none';
          }
        });
      });
    });
  }

  document.addEventListener('astro:page-load', setupRoadmapInteractions);
  setupRoadmapInteractions();
</script>

<style lang="stylus">
  .roadmap-wrapper {
    max-width: 1200px;
    margin: 0 auto 36px auto;
    padding: 0 16px;
  }

  /* Intro Header */
  .roadmap-intro {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 32px 28px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .math-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11.5px;
    font-weight: 600;
    text-transform: uppercase;
    background: var(--color-wrap);
    color: var(--color-default);
    border: 1px solid var(--color-border);
    margin-bottom: 12px;
  }

  .page-title {
    font-size: 26px;
    font-weight: 800;
    color: var(--color-default);
    margin: 0 0 8px 0;
  }

  .page-description {
    font-size: 14.5px;
    color: var(--grey-7);
    margin: 0;
  }

  .intro-stats {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .stats-badge {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 13px;
    color: var(--color-default);
    font-weight: 500;

    .stats-number {
      font-weight: 700;
      color: var(--color-default);
      margin-right: 4px;
    }

    &.highlight {
      border-color: var(--color-default);
    }
  }

  /* Toolbar */
  .roadmap-toolbar {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 14px 20px;
    margin-bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    box-shadow: var(--shadow-card);
  }

  .filter-group {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 7px 16px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--grey-7);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover {
      border-color: var(--color-default);
      color: var(--color-default);
    }

    &.active {
      background: var(--color-default);
      color: var(--color-wrap);
      border-color: var(--color-default);
    }
  }

  .stage-dropdown {
    padding: 8px 14px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: var(--color-wrap);
    color: var(--color-default);
    font-size: 13px;
    outline: none;
    cursor: pointer;
    transition: border-color 0.2s ease;

    &:focus {
      border-color: var(--color-default);
    }
  }

  /* Stage Sections */
  .stage-section {
    margin-bottom: 40px;
    scroll-margin-top: 80px;
  }

  .stage-header {
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .stage-title-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 6px;
  }

  .stage-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    color: var(--color-default);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stage-name {
    font-size: 20px;
    font-weight: 800;
    color: var(--color-default);
    margin: 0;
  }

  .stage-subtitle {
    font-size: 13px;
    color: var(--grey-7);
    font-weight: 600;
  }

  .stage-desc {
    font-size: 14px;
    color: var(--grey-7);
    margin: 6px 0 0 0;
  }

  /* Stage Stepper Overview */
  .stage-stepper-wrap {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px dashed var(--color-border);
  }

  .stepper-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--grey-7);
    margin-bottom: 10px;
  }

  .stepper-track {
    display: flex;
    align-items: stretch;
    gap: 8px;
    flex-wrap: wrap;
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 10px 14px;
  }

  .stepper-node {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--color-default);
    padding: 6px 10px;
    border-radius: 8px;
    transition: all 0.2s ease;
    border: 1px solid transparent;

    &:hover {
      background: var(--color-default);
      color: var(--color-wrap);

      .stepper-badge {
        background: var(--color-wrap);
        color: var(--color-default);
      }
      .stepper-level {
        color: var(--color-wrap);
        opacity: 0.85;
      }
      .stepper-name {
        color: var(--color-wrap);
      }
    }
  }

  .stepper-badge {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-default);
    color: var(--color-wrap);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .stepper-info {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .stepper-level {
    font-size: 10px;
    color: var(--grey-7);
    font-weight: 700;
    text-transform: uppercase;
  }

  .stepper-name {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-default);
  }

  .stepper-arrow {
    color: var(--grey-7);
    opacity: 0.5;
    margin: 0 2px;
    display: flex;
    align-items: center;

    @media screen and (max-width: 767px) {
      display: none;
    }
  }

  /* Groups Container & Cards */
  .groups-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .roadmap-group-card {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 22px;
    scroll-margin-top: 80px;
    box-shadow: var(--shadow-card);
  }

  .group-header {
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .group-badge-line {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .group-step-pill {
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    background: var(--color-default);
    color: var(--color-wrap);
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.5px;
  }

  .group-level-pill {
    font-size: 11px;
    font-weight: 600;
    color: var(--grey-7);
    border: 1px solid var(--color-border);
    padding: 2px 8px;
    border-radius: 6px;
  }

  .group-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-default);
    margin: 0 0 6px 0;
  }

  .group-guide {
    font-size: 13.5px;
    color: var(--grey-7);
    line-height: 1.5;
    margin: 0;
  }

  .node-step-tag {
    font-size: 11px;
    font-weight: 700;
    color: var(--grey-7);
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    padding: 2px 6px;
    border-radius: 6px;
  }

  /* Nodes Grid */
  .nodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 20px;
  }

  .node-card {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 22px;
    box-shadow: var(--shadow-card);
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    &:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-card-hover);
      border-color: var(--color-default);
    }
  }

  .node-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .difficulty-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 10px;
    text-transform: uppercase;

    &.co-ban-olympic { background: rgba(46, 204, 113, 0.15); color: #27ae60; }
    &.chuyen-sau-vmo { background: rgba(52, 152, 219, 0.15); color: #2980b9; }
    &.nang-cao-tst { background: rgba(230, 126, 34, 0.15); color: #d35400; }
    &.dinh-cao-imo { background: rgba(192, 57, 43, 0.15); color: #c0392b; }
  }

  .status-badge {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--grey-7);

    &.completed { color: #27ae60; }
  }

  .node-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-default);
    margin: 0 0 4px 0;
  }

  .node-vietnamese-title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--grey-7);
    margin-bottom: 10px;
  }

  .node-desc {
    font-size: 13.5px;
    color: var(--grey-7);
    line-height: 1.5;
    margin: 0 0 14px 0;
  }

  .formula-box {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 14px;
  }

  .formula-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--grey-7);
    margin-bottom: 4px;
  }

  .formula-rendered {
    overflow-x: auto;
    padding: 6px 0;
    text-align: center;
    color: var(--color-default);

    :global(.katex-display) {
      margin: 4px 0 !important;
    }
  }

  .formula-code {
    font-family: monospace;
    font-size: 13px;
    color: var(--color-default);
    word-break: break-all;
  }

  .theorems-block, .problems-block {
    margin-bottom: 14px;
  }

  .sub-label {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--grey-7);
    margin-bottom: 6px;
  }

  .theorems-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;

    li {
      font-size: 12.5px;
      color: var(--color-default);
      line-height: 1.4;
    }
    .bullet { color: var(--color-default); font-weight: bold; }
  }

  .problem-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .prob-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 11.5px;
    text-decoration: none;
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    color: var(--color-default);
    transition: all 0.2s ease;

    &:hover {
      background: var(--color-default);
      color: var(--color-wrap);
      border-color: var(--color-default);
      transform: translateY(-1px);
    }

    &.imo { border-color: rgba(231, 76, 60, 0.4); }
    &.vmo { border-color: rgba(241, 196, 15, 0.4); }
    &.usamo { border-color: rgba(52, 152, 219, 0.4); }
    &.putnam { border-color: rgba(155, 89, 182, 0.4); }
    &.rmm { border-color: rgba(230, 126, 34, 0.4); }
    &.apmo { border-color: rgba(26, 188, 156, 0.4); }
