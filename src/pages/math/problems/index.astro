---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HeaderTitle from "../../../components/partial/HeaderTitle.astro";
import HeaderSubTitle from "../../../components/partial/HeaderSubTitle.astro";
import Footer from "../../../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { urlFor } from "../../../utils/urlFor";
import { mathProblems, mathCategories } from "../../../data/mathProblems";

const title = "Kho Bài Toán | Math Problems";
const description = "Tuyển chọn 33+ bài toán kinh điển từ Project Euler, CSES Math và Olympic: Lý thuyết số, Ma trận, Tổ hợp, Hình học và Trò chơi.";

const totalProblems = mathProblems.length;
const peCount = mathProblems.filter(p => p.source === "Project Euler").length;
const csesCount = mathProblems.filter(p => p.source === "CSES").length;
const cfCount = mathProblems.filter(p => p.source === "Codeforces").length;
---

<BaseLayout realm="math" title={title} description={description}>
  <HeaderTitle title="Math Problems" url={urlFor("math/problems")} slot="header" />
  <HeaderSubTitle
    subtitle="Kho bài toán tuyển chọn • Rèn luyện tư duy toán học và giải thuật máy tính"
    url={urlFor("math/problems")}
    slot="header"
  />

  <section id="main" aria-label="Main content">
    <div class="problems-wrapper" data-aos="fade-up">
      <!-- Header Intro -->
      <header class="problems-intro">
        <div class="intro-left">
          <div class="math-badge">
            <Icon name="fa6-solid:calculator" size={14} />
            <span>KHO BÀI TOÁN CHỌN LỌC</span>
          </div>
          <h1 class="page-title">{title}</h1>
          <p class="page-description">{description}</p>
        </div>
        <div class="intro-stats">
          <div class="stat-pill">
            <span class="stat-num">{totalProblems}</span> Bài toán
          </div>
          <div class="stat-pill cses-stat">
            <span class="stat-num">{csesCount}</span> CSES
          </div>
          <div class="stat-pill pe-stat">
            <span class="stat-num">{peCount}</span> Project Euler
          </div>
          <div class="stat-pill cf-stat">
            <span class="stat-num">{cfCount}</span> Codeforces
          </div>
        </div>
      </header>

      <!-- Search & Filters -->
      <div class="filter-toolbar">
        <div class="search-box">
          <Icon name="fa6-solid:magnifying-glass" size={14} class="search-icon" />
          <input
            type="text"
            id="problem-search"
            placeholder="Tìm theo tên bài toán, định lý, mã bài (vd: Euler, Diophantine, 1095)..."
            aria-label="Tìm bài toán"
          />
        </div>

        <div class="categories-scroll">
          {mathCategories.map((cat, idx) => (
            <button
              class={`cat-btn ${idx === 0 ? "active" : ""}`}
              data-cat={cat}
              type="button"
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Problems Grid -->
      <div class="problems-grid" id="problems-list">
        {mathProblems.map((prob) => (
          <article
            class="problem-card"
            data-category={prob.category}
            data-source={prob.source}
            data-difficulty={prob.difficulty}
            data-search={`${prob.code} ${prob.title} ${prob.category} ${prob.theorems.join(" ")}`.toLowerCase()}
          >
            <div class="card-top-row">
              <span class={`source-badge ${prob.source.toLowerCase().replace(/\s+/g, '-')}`}>
                {prob.source}
              </span>
              <span class={`diff-badge ${prob.difficulty.toLowerCase()}`}>
                {prob.difficulty}
              </span>
            </div>

            <div class="card-main">
              <div class="prob-code">{prob.code}</div>
              <h2 class="prob-name">{prob.title}</h2>
              <div class="prob-category-tag">{prob.category}</div>
              <p class="prob-latex-desc">{prob.latexDescription}</p>

              <div class="theorems-used">
                <span class="th-label">Công cụ & Định lý:</span>
                <div class="th-tags">
                  {prob.theorems.map((th) => (
                    <span class="th-pill">{th}</span>
                  ))}
                </div>
              </div>
            </div>

            <div class="card-bottom">
              <a
                href={prob.url}
                target="_blank"
                rel="noopener noreferrer"
                class="solve-btn"
                title={`Mở bài toán trên ${prob.source}`}
              >
                <span>Giải bài trên {prob.source}</span>
                <Icon name="fa6-solid:arrow-up-right-from-square" size={12} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function setupSearchAndFilters() {
    const searchInput = document.getElementById('problem-search') as HTMLInputElement | null;
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
    const cards = document.querySelectorAll<HTMLElement>('.problem-card');

    let currentCat = 'Tất cả';
    let searchQuery = '';

    function filterCards() {
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        const searchData = card.getAttribute('data-search') || '';

        const matchesCat = currentCat === 'Tất cả' || cat === currentCat;
        const matchesSearch = !searchQuery || searchData.includes(searchQuery);

        card.style.display = matchesCat && matchesSearch ? 'flex' : 'none';
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        filterCards();
      });
    }

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentCat = btn.getAttribute('data-cat') || 'Tất cả';
        filterCards();
      });
    });
  }

  document.addEventListener('astro:page-load', setupSearchAndFilters);
  setupSearchAndFilters();
</script>

<style lang="stylus">
  .problems-wrapper {
    max-width: 1200px;
    margin: 0 auto 36px auto;
    padding: 0 16px;
  }

  .problems-intro {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 32px 28px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .math-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: rgba(123, 44, 191, 0.12);
    color: #7b2cbf;
    border: 1px solid rgba(123, 44, 191, 0.25);
    margin-bottom: 12px;
  }

  .page-title {
    font-size: 26px;
    font-weight: 800;
    color: var(--color-default);
    margin: 0 0 8px 0;
  }

  .page-description {
    font-size: 14.5px;
    color: var(--grey-7);
    margin: 0;
  }

  .intro-stats {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .stat-pill {
    background: rgba(123, 44, 191, 0.08);
    border: 1px solid rgba(123, 44, 191, 0.2);
    padding: 8px 14px;
    border-radius: 12px;
    font-size: 13px;
    color: var(--color-default);
    font-weight: 500;

    .stat-num {
      font-weight: 700;
      color: #7b2cbf;
      margin-right: 4px;
    }

    &.cses-stat .stat-num { color: #0077b6; }
    &.pe-stat .stat-num { color: #d35400; }
    &.cf-stat .stat-num { color: #27ae60; }
  }

  /* Toolbar */
  .filter-toolbar {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 28px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .search-box {
    position: relative;
    width: 100%;

    .search-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--grey-7);
    }

    input {
      width: 100%;
      padding: 12px 16px 12px 42px;
      border-radius: 12px;
      border: 1px solid var(--color-border);
      background: rgba(53, 90, 117, 0.04);
      color: var(--color-default);
      font-size: 14px;
      outline: none;
      box-sizing: border-box;
      transition: all 0.2s ease;

      &:focus {
        border-color: #7b2cbf;
        box-shadow: 0 0 0 3px rgba(123, 44, 191, 0.15);
        background: var(--color-wrap);
      }
    }
  }

  .categories-scroll {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;

    &::-webkit-scrollbar {
      height: 4px;
    }
    &::-webkit-scrollbar-thumb {
      background: var(--color-border);
      border-radius: 4px;
    }
  }

  .cat-btn {
    white-space: nowrap;
    padding: 6px 14px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--grey-7);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover {
      border-color: #7b2cbf;
      color: #7b2cbf;
    }

    &.active {
      background: #7b2cbf;
      color: #fff;
      border-color: #7b2cbf;
      box-shadow: 0 2px 8px rgba(123, 44, 191, 0.3);
    }
  }

  /* Problems Grid */
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 20px;
  }

  .problem-card {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 22px;
    box-shadow: var(--shadow-card);
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    &:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-card-hover);
      border-color: rgba(123, 44, 191, 0.35);
    }
  }

  .card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .source-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 8px;
    text-transform: uppercase;

    &.cses { background: rgba(0, 119, 182, 0.12); color: #0077b6; }
    &.project-euler { background: rgba(211, 84, 0, 0.12); color: #d35400; }
    &.codeforces { background: rgba(39, 174, 96, 0.12); color: #27ae60; }
    &.vnoj { background: rgba(155, 89, 182, 0.12); color: #8e44ad; }
  }

  .diff-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 8px;

    &.easy { background: rgba(46, 204, 113, 0.12); color: #27ae60; }
    &.medium { background: rgba(52, 152, 219, 0.12); color: #2980b9; }
    &.hard { background: rgba(230, 126, 34, 0.12); color: #d35400; }
    &.master { background: rgba(155, 89, 182, 0.12); color: #8e44ad; }
  }

  .prob-code {
    font-size: 11.5px;
    font-weight: 700;
    color: #7b2cbf;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .prob-name {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-default);
    margin: 0 0 6px 0;
  }

  .prob-category-tag {
    font-size: 12px;
    color: var(--grey-7);
    margin-bottom: 10px;
  }

  .prob-latex-desc {
    font-size: 13.5px;
    color: var(--grey-7);
    line-height: 1.55;
    margin: 0 0 16px 0;
  }

  .theorems-used {
    margin-bottom: 16px;
  }

  .th-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--grey-7);
    margin-bottom: 6px;
  }

  .th-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .th-pill {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(123, 44, 191, 0.08);
    border: 1px solid rgba(123, 44, 191, 0.18);
    color: var(--color-default);
  }

  /* Card Bottom */
  .card-bottom {
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
  }

  .solve-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 9px 16px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    background: rgba(123, 44, 191, 0.1);
    color: #7b2cbf;
    border: 1px solid rgba(123, 44, 191, 0.25);
    transition: all 0.2s ease;
    box-sizing: border-box;

    &:hover {
      background: #7b2cbf;
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(123, 44, 191, 0.25);
    }
  }

  :global([data-theme='dark']) {
    .math-badge {
      background: rgba(186, 104, 200, 0.15);
      color: #ce93d8;
    }
    .stat-num { color: #ce93d8; }
    .prob-code { color: #ce93d8; }
    .th-pill {
      background: rgba(186, 104, 200, 0.1);
      border-color: rgba(186, 104, 200, 0.2);
    }
    .solve-btn {
      background: rgba(186, 104, 200, 0.15);
      color: #ce93d8;
      border-color: rgba(186, 104, 200, 0.3);

      &:hover {
        background: #ab47bc;
        color: #fff;
      }
    }
  }
</style>
