---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HeaderTitle from "../../../components/partial/HeaderTitle.astro";
import HeaderSubTitle from "../../../components/partial/HeaderSubTitle.astro";
import Footer from "../../../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { urlFor } from "../../../utils/urlFor";
import { mathProblems, mathCategories } from "../../../data/mathProblems";
import { renderMathInText } from "../../../utils/renderMath";
import "katex/dist/katex.min.css";

const title = "Kho Đề Toán Olympic | Olympiad Problems Archive";
const description = "Tuyển tập các bài toán kinh điển từ IMO, VMO, USAMO, Putnam, RMM & APMO • Đề bài chi tiết, công thức LaTeX chuẩn mực và hướng dẫn phương pháp giải.";

const totalProblems = mathProblems.length;
const imoCount = mathProblems.filter(p => p.source === "IMO").length;
const vmoCount = mathProblems.filter(p => p.source === "VMO").length;
const usamoCount = mathProblems.filter(p => p.source === "USAMO").length;
const putnamCount = mathProblems.filter(p => p.source === "Putnam").length;
---

<BaseLayout realm="math" title={title} description={description}>
  <HeaderTitle title="Math Olympiad" url={urlFor("math/problems")} slot="header" />
  <HeaderSubTitle
    subtitle="Kho bài toán Olympic quốc tế & quốc gia • Độc lập với tin học • Tư duy suy luận thuần túy"
    url={urlFor("math/problems")}
    slot="header"
  />

  <section id="main" aria-label="Main content">
    <div class="problems-wrapper" data-aos="fade-up">
      <!-- Header Intro -->
      <header class="problems-intro">
        <div class="intro-left">
          <div class="math-badge">
            <Icon name="fa6-solid:award" size={14} />
            <span>KHO BÀI TOÁN OLYMPIC THUẦN TÚY</span>
          </div>
          <h1 class="page-title">{title}</h1>
          <p class="page-description">{description}</p>
        </div>
        <div class="intro-stats">
          <div class="stat-pill">
            <span class="stat-num">{totalProblems}</span> Bài toán
          </div>
          <div class="stat-pill imo-stat">
            <span class="stat-num">{imoCount}</span> IMO
          </div>
          <div class="stat-pill vmo-stat">
            <span class="stat-num">{vmoCount}</span> VMO
          </div>
          <div class="stat-pill usamo-stat">
            <span class="stat-num">{usamoCount}</span> USAMO
          </div>
          <div class="stat-pill putnam-stat">
            <span class="stat-num">{putnamCount}</span> Putnam
          </div>
        </div>
      </header>

      <!-- Search & Filters -->
      <div class="filter-toolbar">
        <div class="search-box">
          <Icon name="fa6-solid:magnifying-glass" size={14} class="search-icon" />
          <input
            type="text"
            id="problem-search"
            placeholder="Tìm theo tên bài, định lý, mã đề (vd: Vieta Jumping, IMO 1988, LTE, Pascal, Schur, VMO)..."
            aria-label="Tìm bài toán"
          />
        </div>

        <div class="categories-scroll">
          {mathCategories.map((cat, idx) => (
            <button
              class={`cat-btn ${idx === 0 ? "active" : ""}`}
              data-cat={cat}
              type="button"
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Problems Grid -->
      <div class="problems-grid" id="problems-list">
        {mathProblems.map((prob) => {
          const diffClass = prob.difficulty
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/\s+/g, "-");
          return (
            <article
              class="problem-card"
              data-category={prob.category}
              data-source={prob.source}
              data-difficulty={prob.difficulty}
              data-search={`${prob.code} ${prob.title} ${prob.category} ${prob.theorems.join(" ")} ${prob.latexDescription}`.toLowerCase()}
            >
              <div class="card-header-row">
                <div class="badges-group">
                  <span class={`source-badge ${prob.source.toLowerCase()}`}>
                    {prob.source} • {prob.year}
                  </span>
                  <span class={`diff-badge ${diffClass}`}>
                    {prob.difficulty}
                  </span>
                </div>
                <div class="prob-code">{prob.code}</div>
              </div>

              <div class="card-main">
                <h2 class="prob-name" set:html={renderMathInText(prob.title)} />
                <div class="prob-category-tag">
                  <Icon name="fa6-solid:folder-open" size={11} />
                  <span>{prob.category}</span>
                </div>

                <!-- Đề bài chi tiết trực tiếp -->
                <div class="problem-statement-box">
                  <div class="statement-title-bar">
                    <Icon name="fa6-solid:scroll" size={12} />
                    <span>Đề bài chi tiết:</span>
                  </div>
                  <div class="prob-latex-desc" set:html={renderMathInText(prob.latexDescription)} />
                </div>

                <!-- Công cụ định lý -->
                <div class="theorems-used">
                  <span class="th-label">Công cụ & Định lý then chốt:</span>
                  <div class="th-tags">
                    {prob.theorems.map((th) => (
                      <span class="th-pill" set:html={renderMathInText(th)} />
                    ))}
                  </div>
                </div>

                <!-- Gợi ý & Phương pháp giải (Accordion tại chỗ) -->
                {prob.hint && (
                  <details class="hint-accordion">
                    <summary class="hint-summary">
                      <div class="hint-summary-left">
                        <Icon name="fa6-solid:lightbulb" size={13} class="bulb-icon" />
                        <span>Gợi ý & Phương pháp giải</span>
                      </div>
                      <Icon name="fa6-solid:chevron-down" size={11} class="chevron-icon" />
                    </summary>
                    <div class="hint-body" set:html={renderMathInText(prob.hint)} />
                  </details>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function setupSearchAndFilters() {
    const searchInput = document.getElementById('problem-search') as HTMLInputElement | null;
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
    const cards = document.querySelectorAll<HTMLElement>('.problem-card');

    let currentCat = 'Tất cả';
    let searchQuery = '';

    // Check URL parameters for search query (e.g. from roadmap)
    const urlParams = new URLSearchParams(window.location.search);
    const searchParam = urlParams.get('search');
    if (searchParam && searchInput) {
      searchInput.value = searchParam;
      searchQuery = searchParam.trim().toLowerCase();
    }

    function filterCards() {
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        const searchData = card.getAttribute('data-search') || '';

        const matchesCat = currentCat === 'Tất cả' || cat === currentCat;
        const matchesSearch = !searchQuery || searchData.includes(searchQuery);

        card.style.display = matchesCat && matchesSearch ? 'flex' : 'none';
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        filterCards();
      });
    }

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentCat = btn.getAttribute('data-cat') || 'Tất cả';
        filterCards();
      });
    });

    filterCards();
  }

  document.addEventListener('astro:page-load', setupSearchAndFilters);
  setupSearchAndFilters();
</script>

<style lang="stylus">
  .problems-wrapper {
    max-width: 1200px;
    margin: 0 auto 36px auto;
    padding: 0 16px;
  }

  .problems-intro {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 32px 28px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .math-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: rgba(123, 44, 191, 0.12);
    color: #7b2cbf;
    border: 1px solid rgba(123, 44, 191, 0.25);
    margin-bottom: 12px;
  }

  .page-title {
    font-size: 26px;
    font-weight: 800;
    color: var(--color-default);
    margin: 0 0 8px 0;
  }

  .page-description {
    font-size: 14.5px;
    color: var(--grey-7);
    margin: 0;
  }

  .intro-stats {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .stat-pill {
    background: rgba(123, 44, 191, 0.08);
    border: 1px solid rgba(123, 44, 191, 0.2);
    padding: 8px 14px;
    border-radius: 12px;
    font-size: 13px;
    color: var(--color-default);
    font-weight: 500;

    .stat-num {
      font-weight: 700;
      color: #7b2cbf;
      margin-right: 4px;
    }

    &.imo-stat .stat-num { color: #e74c3c; }
    &.vmo-stat .stat-num { color: #d4ac0d; }
    &.usamo-stat .stat-num { color: #2980b9; }
    &.putnam-stat .stat-num { color: #8e44ad; }
  }

  /* Toolbar */
  .filter-toolbar {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 28px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .search-box {
    position: relative;
    width: 100%;

    .search-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--grey-7);
    }

    input {
      width: 100%;
      padding: 12px 16px 12px 42px;
      border-radius: 12px;
      border: 1px solid var(--color-border);
      background: rgba(53, 90, 117, 0.04);
      color: var(--color-default);
      font-size: 14px;
      outline: none;
      box-sizing: border-box;
      transition: all 0.2s ease;

      &:focus {
        border-color: #7b2cbf;
        box-shadow: 0 0 0 3px rgba(123, 44, 191, 0.15);
        background: var(--color-wrap);
      }
    }
  }

  .categories-scroll {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;

    &::-webkit-scrollbar {
      height: 4px;
    }
    &::-webkit-scrollbar-thumb {
      background: var(--color-border);
      border-radius: 4px;
    }
  }

  .cat-btn {
    white-space: nowrap;
    padding: 6px 14px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--grey-7);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover {
      border-color: #7b2cbf;
      color: #7b2cbf;
    }

    &.active {
      background: #7b2cbf;
      color: #fff;
      border-color: #7b2cbf;
      box-shadow: 0 2px 8px rgba(123, 44, 191, 0.3);
    }
  }

  /* Problems Grid */
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 22px;
  }

  .problem-card {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 24px;
    box-shadow: var(--shadow-card);
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    &:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-card-hover);
      border-color: rgba(123, 44, 191, 0.35);
    }
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .badges-group {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .source-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 8px;
    text-transform: uppercase;

    &.imo { background: rgba(231, 76, 60, 0.12); color: #e74c3c; }
    &.vmo { background: rgba(241, 196, 15, 0.15); color: #b7950b; }
    &.usamo { background: rgba(52, 152, 219, 0.12); color: #2980b9; }
    &.putnam { background: rgba(155, 89, 182, 0.12); color: #8e44ad; }
    &.rmm { background: rgba(230, 126, 34, 0.12); color: #d35400; }
    &.apmo { background: rgba(26, 188, 156, 0.12); color: #16a085; }
  }

  .diff-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 8px;

    &.co-ban-olympic { background: rgba(46, 204, 113, 0.12); color: #27ae60; }
    &.chuyen-sau-vmo { background: rgba(52, 152, 219, 0.12); color: #2980b9; }
    &.nang-cao-tst { background: rgba(230, 126, 34, 0.12); color: #d35400; }
    &.dinh-cao-imo { background: rgba(192, 57, 43, 0.15); color: #c0392b; font-weight: 700; }
  }

  .prob-code {
    font-size: 12px;
    font-weight: 700;
    color: #7b2cbf;
    letter-spacing: 0.5px;
  }

  .card-main {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .prob-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-default);
    margin: 0 0 6px 0;
    line-height: 1.35;
  }

  .prob-category-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: var(--grey-7);
    margin-bottom: 12px;
  }

  /* Đề bài chi tiết Box */
  .problem-statement-box {
    background: rgba(123, 44, 191, 0.03);
    border: 1px solid rgba(123, 44, 191, 0.15);
    border-radius: 12px;
    padding: 14px 16px;
    margin: 0 0 16px 0;
  }

  .statement-title-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #7b2cbf;
    margin-bottom: 8px;
  }

  .prob-latex-desc {
    font-size: 14px;
    color: var(--color-default);
    line-height: 1.6;
    margin: 0;
  }

  /* Định lý */
  .theorems-used {
    margin-bottom: 14px;
  }

  .th-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--grey-7);
    margin-bottom: 6px;
  }

  .th-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .th-pill {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(123, 44, 191, 0.08);
    border: 1px solid rgba(123, 44, 191, 0.18);
    color: var(--color-default);
  }

  /* Accordion Gợi ý */
  .hint-accordion {
    margin-top: auto;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.015);
    overflow: hidden;
    transition: all 0.2s ease;

    &[open] {
      border-color: rgba(123, 44, 191, 0.35);
      background: rgba(123, 44, 191, 0.02);

      .chevron-icon {
        transform: rotate(180deg);
      }
    }
  }

  .hint-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    cursor: pointer;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-default);
    user-select: none;
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      color: #7b2cbf;
    }
  }

  .hint-summary-left {
    display: flex;
    align-items: center;
    gap: 7px;

    .bulb-icon {
      color: #f39c12;
    }
  }

  .chevron-icon {
    transition: transform 0.2s ease;
    color: var(--grey-7);
  }

  .hint-body {
    padding: 12px 14px;
    border-top: 1px solid var(--color-border);
    font-size: 13px;
    line-height: 1.6;
    color: var(--grey-8);
    background: var(--color-wrap);
  }

  :global([data-theme='dark']) {
    .math-badge {
      background: rgba(186, 104, 200, 0.15);
      color: #ce93d8;
    }
    .stat-num { color: #ce93d8; }
    .prob-code { color: #ce93d8; }
    .problem-statement-box {
      background: rgba(186, 104, 200, 0.05);
      border-color: rgba(186, 104, 200, 0.2);
    }
    .statement-title-bar {
      color: #ce93d8;
    }
    .th-pill {
      background: rgba(186, 104, 200, 0.1);
      border-color: rgba(186, 104, 200, 0.2);
    }
    .hint-accordion[open] {
      border-color: rgba(186, 104, 200, 0.35);
      background: rgba(186, 104, 200, 0.04);
    }
  }
</style>
