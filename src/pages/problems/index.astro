---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeaderTitle from "../../components/partial/HeaderTitle.astro";
import Footer from "../../components/Footer.astro";
import { urlFor } from "../../utils/urlFor";
import { problemCategories } from "../../data/problems";

const title = "Problems";
const description = "Nơi lưu lại những bài toán hay mà mình muốn luyện tập và xem lại.";

const totalProblems = problemCategories.reduce(
  (sum, category) => sum + category.problems.length,
  0
);
---

<BaseLayout title={title} description={description}>
  <HeaderTitle title={title} url={urlFor("problems")} slot="header" />

  <section id="main" aria-label="Main content">
    <div class="problems-wrapper" data-aos="fade-up">
      <header class="problems-intro">
        <div class="intro-content">
          <h1 class="page-title">{title}</h1>
          <p class="page-description">{description}</p>
        </div>
        <div class="intro-stats">
          <span class="stats-badge">
            <span class="stats-number">{problemCategories.length}</span> chủ đề
          </span>
          <span class="stats-badge">
            <span class="stats-number">{totalProblems}</span> bài toán
          </span>
        </div>
      </header>

      <div class="categories-list">
        {
          problemCategories.map((category) => (
            <details class="category-card" open>
              <summary class="category-summary">
                <div class="summary-left">
                  <svg
                    class="chevron-icon"
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    stroke="currentColor"
                    stroke-width="2.5"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                  <span class="category-name">{category.name}</span>
                </div>
                <div class="summary-right">
                  <span class="count-pill">
                    {category.problems.length} bài toán
                  </span>
                </div>
              </summary>

              <div class="category-body">
                {category.description && (
                  <p class="category-desc">{category.description}</p>
                )}
                <ul class="problems-table">
                  {category.problems.map((problem) => (
                    <li class="problem-row">
                      <div class="problem-left">
                        <span class="problem-code">
                          {problem.platform
                            ? `${problem.platform} #${problem.id}`
                            : `#${problem.id}`}
                        </span>
                        <span class="problem-title">{problem.title}</span>
                      </div>
                      <div class="problem-right">
                        <a
                          href={problem.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="open-problem-btn"
                          aria-label={`Mở bài toán ${problem.title}`}
                        >
                          <span>Mở bài toán</span>
                          <svg
                            viewBox="0 0 24 24"
                            width="14"
                            height="14"
                            stroke="currentColor"
                            stroke-width="2"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                            <polyline points="15 3 21 3 21 9" />
                            <line x1="10" y1="14" x2="21" y2="3" />
                          </svg>
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .problems-wrapper {
    width: 100%;
    margin-bottom: 24px;
  }

  .problems-intro {
    background: var(--color-wrap);
    border-radius: 12px;
    padding: 24px 28px;
    margin-bottom: 20px;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .intro-content {
    flex: 1;
    min-width: 250px;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-default);
    margin: 0 0 6px 0;
  }

  .page-description {
    font-size: 0.95rem;
    color: var(--grey-9);
    margin: 0;
    line-height: 1.5;
  }

  .intro-stats {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .stats-badge {
    background: var(--red-5-5);
    color: var(--color-default);
    border: 1px solid var(--red-5);
    font-size: 0.85rem;
    padding: 6px 14px;
    border-radius: 20px;
    font-weight: 500;
  }

  .stats-number {
    color: var(--red-0);
    font-weight: 700;
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .category-card {
    background: var(--color-wrap);
    border-radius: 12px;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .category-card:hover {
    border-color: var(--red-2);
    box-shadow: var(--shadow-card-hover);
  }

  .category-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .category-summary::-webkit-details-marker {
    display: none;
  }

  .category-summary:hover {
    background: var(--red-5-5);
  }

  .category-summary:focus-visible {
    outline: 2px solid var(--red-2);
    outline-offset: -2px;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .chevron-icon {
    color: var(--red-1);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  details[open] > .category-summary .chevron-icon {
    transform: rotate(90deg);
  }

  .category-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-default);
    letter-spacing: 0.2px;
  }

  .count-pill {
    background: var(--red-5);
    color: var(--red-0);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
  }

  .category-body {
    padding: 4px 24px 24px 24px;
    border-top: 1px dashed var(--color-border);
    animation: fadeIn 0.25s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .category-desc {
    font-size: 0.9rem;
    color: var(--grey-9);
    margin: 14px 0 12px 0;
    line-height: 1.5;
  }

  .problems-table {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .problem-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: var(--red-6);
    border: 1px solid var(--red-5);
    border-radius: 8px;
    gap: 16px;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .problem-row:hover {
    background: var(--red-5-5);
    border-color: var(--red-3);
    transform: translateY(-1px);
  }

  .problem-left {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .problem-code {
    background: var(--red-1);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 6px;
    letter-spacing: 0.5px;
    flex-shrink: 0;
  }

  .problem-title {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-default);
    word-break: break-word;
  }

  .problem-right {
    flex-shrink: 0;
  }

  .open-problem-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--red-1);
    color: #ffffff !important;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 7px 15px;
    border-radius: 6px;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.15s ease;
    box-shadow: 0 2px 6px rgba(74, 159, 216, 0.25);
  }

  .open-problem-btn:hover {
    background: var(--red-0);
    box-shadow: 0 4px 10px rgba(53, 122, 189, 0.35);
    transform: translateY(-1px);
  }

  .open-problem-btn svg {
    transition: transform 0.2s ease;
  }

  .open-problem-btn:hover svg {
    transform: translate(2px, -2px);
  }

  @media screen and (max-width: 600px) {
    .problems-intro {
      padding: 18px 20px;
    }
    .page-title {
      font-size: 1.4rem;
    }
    .category-summary {
      padding: 14px 18px;
    }
    .category-body {
      padding: 4px 16px 18px 16px;
    }
    .problem-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 14px;
    }
    .problem-right {
      width: 100%;
    }
    .open-problem-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
