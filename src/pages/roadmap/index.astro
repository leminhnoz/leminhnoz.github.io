---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeaderTitle from "../../components/partial/HeaderTitle.astro";
import Footer from "../../components/Footer.astro";
import { urlFor } from "../../utils/urlFor";
import { roadmapStages } from "../../data/roadmap";

const title = "Roadmap";
const description = "Lộ trình học Competitive Programming toàn diện từ con số 0 đến Master thuật toán.";

const totalStages = roadmapStages.length;
const totalNodes = roadmapStages.reduce((sum, stage) => sum + stage.nodes.length, 0);
const completedNodes = roadmapStages.reduce(
  (sum, stage) => sum + stage.nodes.filter(n => n.status === "completed").length,
  0
);
---

<BaseLayout title={title} description={description}>
  <HeaderTitle title={title} url={urlFor("roadmap")} slot="header" />

  <section id="main" aria-label="Main content">
    <div class="roadmap-wrapper" data-aos="fade-up">
      <!-- Intro Header -->
      <header class="roadmap-intro">
        <div class="intro-content">
          <h1 class="page-title">{title}</h1>
          <p class="page-description">{description}</p>
        </div>
        <div class="intro-stats">
          <div class="stats-badge">
            <span class="stats-number">{totalStages}</span> Giai đoạn
          </div>
          <div class="stats-badge">
            <span class="stats-number">{totalNodes}</span> Chủ đề
          </div>
          <div class="stats-badge highlight">
            <span class="stats-number">{completedNodes}</span> Đã có Blog
          </div>
        </div>
      </header>

      <!-- Roadmap Navigation & Filter Pills -->
      <div class="roadmap-toolbar">
        <div class="filter-group" role="tablist" aria-label="Lọc theo trạng thái bài viết">
          <button class="filter-btn active" data-filter="all" type="button">Tất cả ({totalNodes})</button>
          <button class="filter-btn" data-filter="completed" type="button">Đã có Blog ({completedNodes})</button>
          <button class="filter-btn" data-filter="advanced" type="button">Chuyên sâu ({totalNodes - completedNodes})</button>
        </div>
        <div class="quick-jump">
          <label for="stage-select" class="sr-only">Nhảy tới giai đoạn</label>
          <select id="stage-select" class="stage-dropdown" aria-label="Nhảy tới giai đoạn">
            <option value="">-- Nhảy tới Giai đoạn --</option>
            {roadmapStages.map(stage => (
              <option value={`stage-${stage.id}`}>Stage {stage.id}: {stage.subtitle}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Roadmap Stages Timeline -->
      <div class="stages-timeline">
        {roadmapStages.map((stage) => (
          <article class="stage-card" id={`stage-${stage.id}`}>
            <header class="stage-header">
              <div class="stage-badge-col">
                <span class="stage-num">0{stage.id}</span>
                <span class="stage-pill">STAGE</span>
              </div>
              <div class="stage-title-col">
                <h2 class="stage-title">{stage.title}</h2>
                <h3 class="stage-subtitle">{stage.subtitle}</h3>
                <p class="stage-desc">{stage.description}</p>
              </div>
              <div class="stage-count-col">
                <span class="nodes-count-tag">{stage.nodes.length} chủ đề</span>
              </div>
            </header>

            <div class="stage-nodes-grid">
              {stage.nodes.map((node) => (
                <div 
                  class={`roadmap-node-card status-${node.status} diff-${node.difficulty.toLowerCase()}`}
                  data-status={node.status}
                  id={`node-${node.id}`}
                >
                  <div class="node-top-bar">
                    <span class={`difficulty-badge ${node.difficulty.toLowerCase()}`}>
                      {node.difficulty}
                    </span>
                    <span class={`status-badge ${node.status}`}>
                      {node.status === "completed" && "✓ Có Blog"}
                      {node.status === "missing" && "⏳ Đang viết"}
                      {node.status === "advanced" && "★ Nâng cao"}
                    </span>
                  </div>

                  <h4 class="node-title">{node.title}</h4>
                  <p class="node-desc">{node.description}</p>

                  {node.prerequisites && node.prerequisites.length > 0 && (
                    <div class="node-prereqs">
                      <span class="prereq-label">Tiên quyết:</span>
                      <div class="prereq-tags">
                        {node.prerequisites.map(prereq => (
                          <span class="prereq-tag">#{prereq}</span>
                        ))}
                      </div>
                    </div>
                  )}

                  {node.fact && (
                    <div class="node-fact">
                      <span class="fact-icon" aria-hidden="true">💡</span>
                      <p class="fact-text"><strong>Fun fact:</strong> {node.fact}</p>
                    </div>
                  )}

                  {node.objectives && node.objectives.length > 0 && (
                    <details class="node-objectives-details">
                      <summary class="objectives-summary">
                        <span>Mục tiêu cốt lõi ({node.objectives.length})</span>
                      </summary>
                      <ul class="objectives-list">
                        {node.objectives.map(obj => (
                          <li>{obj}</li>
                        ))}
                      </ul>
                    </details>
                  )}

                  <div class="node-footer">
                    {node.blogSlug ? (
                      <a 
                        href={`/blog/${node.blogSlug}`} 
                        class="node-blog-btn"
                        title={node.blogTitle || node.title}
                      >
                        <span>Đọc bài giảng</span>
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </a>
                    ) : (
                      <span class="node-no-blog">Đang cập nhật bài viết</span>
                    )}

                    {node.problems && node.problems.length > 0 && (
                      <div class="node-problems-trigger">
                        <span class="problems-count-pill">
                          {node.problems.length} bài tập
                        </span>
                      </div>
                    )}
                  </div>

                  {node.problems && node.problems.length > 0 && (
                    <div class="node-problems-list">
                      <span class="problems-list-title">Bài tập đề xuất:</span>
                      <div class="problems-chips">
                        {node.problems.map(prob => (
                          <a 
                            href={prob.url} 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="problem-chip"
                            title={`Mở bài tập ${prob.title} (${prob.platform})`}
                          >
                            <span class="platform-chip-tag">{prob.platform}</span>
                            <span class="prob-chip-id">#{prob.id}</span>
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Filter buttons interaction
  function setupRoadmapInteractions() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const nodeCards = document.querySelectorAll<HTMLElement>(".roadmap-node-card");
    const stageSelect = document.getElementById("stage-select") as HTMLSelectElement | null;

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");

        const filter = btn.dataset.filter || "all";

        nodeCards.forEach((card) => {
          const status = card.dataset.status;
          if (filter === "all") {
            card.style.display = "";
          } else if (filter === "completed" && status === "completed") {
            card.style.display = "";
          } else if (filter === "advanced" && status !== "completed") {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      });
    });

    if (stageSelect) {
      stageSelect.addEventListener("change", (e) => {
        const targetId = (e.target as HTMLSelectElement).value;
        if (targetId) {
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }
      });
    }
  }

  document.addEventListener("astro:page-load", setupRoadmapInteractions);
  setupRoadmapInteractions();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .roadmap-wrapper {
    max-width: 1040px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3.5rem;
  }

  /* Intro Header */
  .roadmap-intro {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px dashed rgba(180, 215, 245, 0.5);
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--color-text, #2c3e50);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .page-description {
    font-size: 1.05rem;
    color: var(--color-meta, #607d8b);
    margin: 0;
    line-height: 1.5;
  }

  .intro-stats {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .stats-badge {
    background: #eef7fc;
    color: #2b7bb9;
    padding: 0.45rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid rgba(180, 215, 245, 0.6);
  }

  .stats-badge.highlight {
    background: #e3f2fd;
    color: #1976d2;
    border-color: #90caf9;
  }

  .stats-number {
    font-weight: 800;
  }

  /* Toolbar */
  .roadmap-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    gap: 0.4rem;
    background: #f1f8fc;
    padding: 0.3rem;
    border-radius: 9999px;
    border: 1px solid rgba(180, 215, 245, 0.4);
  }

  .filter-btn {
    border: none;
    background: transparent;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #607d8b;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    color: #1976d2;
  }

  .filter-btn.active {
    background: #ffffff;
    color: #1976d2;
    box-shadow: 0 2px 6px rgba(43, 123, 185, 0.15);
  }

  .stage-dropdown {
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(180, 215, 245, 0.8);
    background: #ffffff;
    color: #2b7bb9;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  .stage-dropdown:focus {
    border-color: #2b7bb9;
  }

  /* Stages Timeline */
  .stages-timeline {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .stage-card {
    background: #ffffff;
    border-radius: 1.25rem;
    border: 1px solid rgba(180, 215, 245, 0.5);
    padding: 1.75rem;
    box-shadow: 0 4px 16px rgba(180, 215, 245, 0.12);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .stage-card:hover {
    box-shadow: 0 6px 20px rgba(180, 215, 245, 0.2);
  }

  .stage-header {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(220, 235, 245, 0.8);
    margin-bottom: 1.5rem;
  }

  .stage-badge-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #e8f4fd;
    color: #1976d2;
    padding: 0.6rem 0.8rem;
    border-radius: 1rem;
    border: 1px solid rgba(144, 202, 249, 0.5);
    flex-shrink: 0;
  }

  .stage-num {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
  }

  .stage-pill {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-top: 0.2rem;
  }

  .stage-title-col {
    flex: 1;
  }

  .stage-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #2c3e50;
    margin: 0 0 0.25rem 0;
  }

  .stage-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: #2b7bb9;
    margin: 0 0 0.5rem 0;
  }

  .stage-desc {
    font-size: 0.9rem;
    color: #607d8b;
    margin: 0;
    line-height: 1.5;
  }

  .stage-count-col {
    flex-shrink: 0;
  }

  .nodes-count-tag {
    font-size: 0.8rem;
    font-weight: 700;
    background: #f1f8fc;
    color: #2b7bb9;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(180, 215, 245, 0.5);
  }

  /* Node Cards Grid */
  .stage-nodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .roadmap-node-card {
    background: #fbfdff;
    border: 1px solid rgba(195, 225, 248, 0.7);
    border-radius: 1rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .roadmap-node-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(43, 123, 185, 0.12);
    border-color: #64b5f6;
  }

  .node-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .difficulty-badge {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
  }

  .difficulty-badge.beginner {
    background: #e8f5e9;
    color: #2e7d32;
    border: 1px solid #c8e6c9;
  }

  .difficulty-badge.easy {
    background: #e0f2f1;
    color: #00796b;
    border: 1px solid #b2dfdb;
  }

  .difficulty-badge.medium {
    background: #fff8e1;
    color: #f57f17;
    border: 1px solid #ffe082;
  }

  .difficulty-badge.hard {
    background: #fbe9e7;
    color: #d84315;
    border: 1px solid #ffccbc;
  }

  .difficulty-badge.advanced {
    background: #f3e5f5;
    color: #7b1fa2;
    border: 1px solid #e1bee7;
  }

  .status-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.18rem 0.5rem;
    border-radius: 0.35rem;
  }

  .status-badge.completed {
    background: #e3f2fd;
    color: #1976d2;
  }

  .status-badge.missing {
    background: #fff3e0;
    color: #e65100;
  }

  .status-badge.advanced {
    background: #f3e5f5;
    color: #8e24aa;
  }

  .node-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #2c3e50;
    margin: 0;
    line-height: 1.35;
  }

  .node-desc {
    font-size: 0.85rem;
    color: #607d8b;
    margin: 0;
    line-height: 1.45;
    flex: 1;
  }

  /* Prereqs */
  .node-prereqs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    flex-wrap: wrap;
  }

  .prereq-label {
    color: #90a4ae;
    font-weight: 600;
  }

  .prereq-tags {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .prereq-tag {
    background: #edf6fd;
    color: #2b7bb9;
    padding: 0.1rem 0.4rem;
    border-radius: 0.25rem;
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 600;
  }

  /* Fun Fact */
  .node-fact {
    background: #fffde7;
    border-left: 3px solid #fbc02d;
    padding: 0.5rem 0.65rem;
    border-radius: 0.4rem;
    font-size: 0.78rem;
    color: #5d4037;
    line-height: 1.4;
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
  }

  .fact-icon {
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .fact-text {
    margin: 0;
  }

  /* Objectives Dropdown */
  .node-objectives-details {
    background: #f8fbfe;
    border-radius: 0.4rem;
    border: 1px solid rgba(195, 225, 248, 0.4);
    font-size: 0.78rem;
  }

  .objectives-summary {
    padding: 0.35rem 0.6rem;
    font-weight: 700;
    color: #2b7bb9;
    cursor: pointer;
    user-select: none;
  }

  .objectives-list {
    margin: 0;
    padding: 0.4rem 0.8rem 0.5rem 1.4rem;
    color: #546e7a;
    line-height: 1.45;
  }

  .objectives-list li {
    margin-bottom: 0.25rem;
  }

  /* Footer & Action Buttons */
  .node-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed rgba(195, 225, 248, 0.6);
  }

  .node-blog-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #e3f2fd;
    color: #1976d2;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid rgba(144, 202, 249, 0.6);
    transition: all 0.2s;
  }

  .node-blog-btn:hover {
    background: #1976d2;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(25, 118, 210, 0.3);
  }

  .node-no-blog {
    font-size: 0.75rem;
    font-weight: 600;
    color: #b0bec5;
    font-style: italic;
  }

  .problems-count-pill {
    font-size: 0.75rem;
    font-weight: 700;
    color: #607d8b;
    background: #eceff1;
    padding: 0.25rem 0.55rem;
    border-radius: 9999px;
  }

  /* Problems Chips */
  .node-problems-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: #f1f8fc;
    padding: 0.5rem 0.65rem;
    border-radius: 0.5rem;
  }

  .problems-list-title {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #2b7bb9;
    letter-spacing: 0.03em;
  }

  .problems-chips {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .problem-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: #ffffff;
    border: 1px solid rgba(180, 215, 245, 0.7);
    padding: 0.2rem 0.45rem;
    border-radius: 0.35rem;
    text-decoration: none;
    font-size: 0.72rem;
    color: #37474f;
    transition: all 0.15s;
  }

  .problem-chip:hover {
    border-color: #2b7bb9;
    color: #1976d2;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(43, 123, 185, 0.15);
  }

  .platform-chip-tag {
    font-weight: 800;
    color: #1976d2;
    font-size: 0.65rem;
  }

  .prob-chip-id {
    font-family: monospace;
    font-weight: 700;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .roadmap-intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .intro-stats {
      flex-wrap: wrap;
    }

    .stage-header {
      flex-direction: column;
      gap: 0.75rem;
    }

    .stage-count-col {
      align-self: flex-start;
    }

    .stage-nodes-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Dark theme overrides */
  :global([data-theme="dark"]) .roadmap-intro {
    border-bottom-color: rgba(60, 90, 120, 0.4);
  }

  :global([data-theme="dark"]) .page-title,
  :global([data-theme="dark"]) .stage-title,
  :global([data-theme="dark"]) .node-title {
    color: #e2e8f0;
  }

  :global([data-theme="dark"]) .page-description,
  :global([data-theme="dark"]) .stage-desc,
  :global([data-theme="dark"]) .node-desc {
    color: #94a3b8;
  }

  :global([data-theme="dark"]) .stage-card {
    background: #1e293b;
    border-color: #334155;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  :global([data-theme="dark"]) .roadmap-node-card {
    background: #0f172a;
    border-color: #334155;
  }

  :global([data-theme="dark"]) .stage-badge-col {
    background: #1e3a5f;
    color: #60a5fa;
    border-color: #2563eb;
  }

  :global([data-theme="dark"]) .filter-group {
    background: #0f172a;
    border-color: #334155;
  }

  :global([data-theme="dark"]) .filter-btn {
    color: #94a3b8;
  }

  :global([data-theme="dark"]) .filter-btn.active {
    background: #1e293b;
    color: #60a5fa;
  }

  :global([data-theme="dark"]) .stage-dropdown {
    background: #1e293b;
    border-color: #334155;
    color: #93c5fd;
  }

  :global([data-theme="dark"]) .node-fact {
    background: #2a2514;
    border-left-color: #eab308;
    color: #fef08a;
  }

  :global([data-theme="dark"]) .node-objectives-details {
    background: #1e293b;
    border-color: #334155;
  }

  :global([data-theme="dark"]) .objectives-list {
    color: #cbd5e1;
  }

  :global([data-theme="dark"]) .node-problems-list {
    background: #1e293b;
  }

  :global([data-theme="dark"]) .problem-chip {
