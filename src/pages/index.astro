---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../utils/config";
import { urlFor } from "../utils/urlFor";

const title = "Home";
const description = "Blog và ghi chép cá nhân về lập trình thi đấu và toán học.";
---

<BaseLayout
  isGateway={true}
  title={`${SITE.title} | ${title}`}
  description={description}
>
  <div class="gateway-screen">
    <!-- Center Avatar & Minimal Branding -->
    <div class="gateway-hero">
      <div class="avatar-wrap">
        <img
          src={urlFor("images/avatar.png")}
          alt="clearluv4ever_"
          class="gateway-avatar"
          width="84"
          height="84"
        />
      </div>
      <h1 class="gateway-name">clearluv4ever_</h1>
      <p class="gateway-tagline">
        Ghi chép về lập trình thi đấu và toán học.
      </p>
    </div>

    <!-- 2 Clean Monochrome Cards -->
    <div class="gateway-options">
      <!-- Option 1: Math -->
      <a href={urlFor("math")} class="realm-card">
        <div class="card-top">
          <div class="card-icon">
            <Icon name="fa6-solid:square-root-variable" size={18} />
          </div>
          <span class="card-arrow">
            <Icon name="fa6-solid:arrow-right" size={12} />
          </span>
        </div>
        <div class="card-main">
          <h2 class="card-title">Toán học</h2>
          <p class="card-desc">
            Số học, đại số, hình học phẳng, tổ hợp và kho đề Olympic chọn lọc.
          </p>
          <div class="card-meta">
            <span>6 giai đoạn</span>
            <span class="dot">•</span>
            <span>55 bài tập</span>
          </div>
        </div>
      </a>

      <!-- Option 2: Programming -->
      <a href={urlFor("programming")} class="realm-card">
        <div class="card-top">
          <div class="card-icon">
            <Icon name="fa6-solid:code" size={18} />
          </div>
          <span class="card-arrow">
            <Icon name="fa6-solid:arrow-right" size={12} />
          </span>
        </div>
        <div class="card-main">
          <h2 class="card-title">Lập trình</h2>
          <p class="card-desc">
            Thuật toán, cấu trúc dữ liệu, lộ trình ICPC và bài tập giải thuật.
          </p>
          <div class="card-meta">
            <span>53 bài viết</span>
            <span class="dot">•</span>
            <span>128 bài tập</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>

<style lang="stylus">
  .gateway-screen {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 16px;
  }

  .gateway-hero {
    text-align: center;
    margin-bottom: 32px;
  }

  .avatar-wrap {
    width: 88px;
    height: 88px;
    margin: 0 auto 16px auto;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    padding: 3px;
    background: var(--color-wrap);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    transition: transform 0.25s ease;

    &:hover {
      transform: scale(1.05);
    }
  }

  .gateway-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .gateway-name {
    font-size: 26px;
    font-weight: 700;
    color: var(--color-default);
    margin: 0 0 6px 0;
    letter-spacing: -0.5px;
  }

  .gateway-tagline {
    font-size: 14.5px;
    color: var(--grey-7);
    margin: 0;
    line-height: 1.5;
  }

  .gateway-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    width: 100%;

    @media screen and (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .realm-card {
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 22px 20px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;

    &:hover {
      border-color: var(--color-default);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);

      .card-arrow {
        transform: translateX(3px);
        color: var(--color-default);
      }
    }
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .card-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--color-border);
    color: var(--color-default);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-arrow {
    color: var(--grey-7);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .card-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-default);
    margin: 0 0 6px 0;
  }

  .card-desc {
    font-size: 13px;
    color: var(--grey-7);
    line-height: 1.5;
    margin: 0 0 12px 0;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--grey-7);

    .dot {
      opacity: 0.5;
    }
  }
</style>
