---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, HOME_CATEGORIES, BANNER } from "../../utils/config";
import randomCover from "../../utils/randomCover";
import { _p } from "../../utils/i18n";
import { wordCount, readingTime } from "../../utils/wordCount";
import Footer from "../../components/Footer.astro";
import Pagination from "../../components/Pagination.astro";
import HeaderTitle from "../../components/partial/HeaderTitle.astro";
import HeaderSubTitle from "../../components/partial/HeaderSubTitle.astro";
import HomeCategories from "../../components/HomeCategories.astro";
import { formatDate } from "../../utils/formatDate";
import { urlFor } from "../../utils/urlFor";
import { sortPosts } from "../../utils/sortPosts";

type Props = {
  page: {
    data: CollectionEntry<"blog">[];
    url: {
      prev: string;
      next: string;
    };
    currentPage: number;
    lastPage: number;
  };
};

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const posts = await getCollection("blog");
  const sortedPosts = posts.sort(sortPosts);
  return paginate(sortedPosts, {
    pageSize: 10,
  });
}
const { page } = Astro.props;
---

<BaseLayout
  realm="programming"
  title={`${SITE.title} | Programming & CP`}
  description="Phân hệ Lập trình: Thuật toán, Cấu trúc dữ liệu và Lộ trình luyện thi ICPC."
>
  <!-- Header -->
  <HeaderTitle title={SITE.title} url={urlFor("programming")} slot="header" />
  <HeaderSubTitle
    subtitle="Phân hệ Lập trình • Algorithms & Competitive Programming"
    url={urlFor("programming")}
    slot="header"
  />

  <!-- Content -->
  <section id="main" aria-label="Main content">
    <!-- Realm Switcher Bar -->
    <div class="realm-banner" data-aos="fade-down">
      <div class="realm-info">
        <span class="realm-badge active">
          <Icon name="fa6-solid:code" size={14} />
          Lập trình (Programming)
        </span>
        <span class="realm-desc">53 bài viết thuật toán • Lộ trình 7 giai đoạn • 128 bài tập</span>
      </div>
      <div class="realm-actions">
        <a href={urlFor("math")} class="realm-switch-btn" title="Chuyển sang phân hệ Toán">
          <Icon name="fa6-solid:square-root-variable" size={14} />
          <span>Sang Toán học</span>
        </a>
        <a href={urlFor("/")} class="realm-portal-btn" title="Quay về cổng chọn phân hệ">
          <Icon name="fa6-solid:door-open" size={14} />
          <span>Đổi phân hệ</span>
        </a>
      </div>
    </div>

    {
      HOME_CATEGORIES.enable && (
        <HomeCategories content={HOME_CATEGORIES.content} />
      )
    }
    {
      page.data.map((post, index) => (
        <div class="post-wrapper">
          <div
            class:list={["post-wrap", { right: index % 2 === 1 }]}
            data-aos="fade-up"
          >
            <a
              class="post-link"
              href={urlFor(`blog/${post.id}`)}
              aria-label={post.id}
            />
            <div class:list={["post-cover", { right: index % 2 === 1 }]}>
              <img
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                src={urlFor(post.data.cover || randomCover() || BANNER)}
                alt={post.data.title}
              />
            </div>
            <div class="post-info">
              <div class="post-meta">
                <span>
                  <Icon name="fa6-solid:calendar" size={14} />
                  &nbsp;
                  {formatDate(post.data.pubDate)}
                </span>
                <span>
                  <Icon name="fa6-solid:pen-nib" size={14} />
                  &nbsp;
                  {_p("post.count", wordCount(post.body || ""))}
                </span>
                <span>
                  <Icon name="fa6-solid:hourglass-half" size={14} />
                  &nbsp;
                  {_p("post.time", readingTime(post.body || ""))}
                </span>
              </div>
              <h2 class="post-title">{post.data.title}</h2>
              <article class="post-article">
                {post.data.excerpt ? (
                  <p>{post.data.excerpt}</p>
                ) : (
                  <p>{post.body?.slice(0, 300)}</p>
                )}
              </article>
            </div>
          </div>
        </div>
      ))
    }
    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      url="/programming"
    />
  </section>
  <!-- Footer -->
  <Footer slot="footer" />
</BaseLayout>

<style lang="stylus">
  .realm-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 12px 18px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-card);
    flex-wrap: wrap;
    gap: 12px;
  }

  .realm-info {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .realm-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    background: linear-gradient(135deg, #0077b6, #0096c7);
    color: #fff;
    box-shadow: 0 2px 8px rgba(0, 150, 199, 0.35);
  }

  .realm-desc {
    font-size: 13px;
    color: var(--grey-7);
  }

  .realm-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .realm-switch-btn, .realm-portal-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .realm-switch-btn {
    background: rgba(138, 43, 226, 0.1);
    color: #8a2be2;
    border: 1px solid rgba(138, 43, 226, 0.25);

    &:hover {
      background: #8a2be2;
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(138, 43, 226, 0.25);
    }
  }

  .realm-portal-btn {
    background: rgba(100, 116, 139, 0.1);
    color: var(--grey-7);
    border: 1px solid var(--color-border);

    &:hover {
      background: var(--red-1);
      color: #fff;
      border-color: var(--red-1);
      transform: translateY(-1px);
    }
  }

  :global(.post-link) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .post-wrap {
    width: 100%;
    height: 232px;
    margin-bottom: 32px;
    position: relative;
    border-radius: 12px;
    background: var(--color-wrap);
    display: flex;
    flex-direction: row;
    transition: 0.3s;

    &.right {
      flex-direction: row-reverse;
    }

    @media screen and (max-width: 767px) {
      flex-direction: column;
      height: 400px;
      margin-bottom: 20px;
      &.right {
        flex-direction: column;
      }
    }
  }

  :global([data-theme='dark'])  {
    .post-wrap.left, .post-wrap.right {
      box-shadow: var(--shadow-card);
    }
    .realm-switch-btn {
      background: rgba(186, 104, 200, 0.15);
      color: #ce93d8;
      border-color: rgba(186, 104, 200, 0.3);

      &:hover {
        background: #ab47bc;
        color: #fff;
      }
    }
  }

  .post-wrapper {
    border-radius: 12px;
    transition: 0.3s;

    .aos-animate {
      transition-property: initial !important;

      @media screen and (min-width: 768px) {
        &:hover {
          box-shadow: var(--shadow-card-hover);
        }
      }
    }

    img {
      will-change: transform;
    }

    @media screen and (min-width: 768px) {
      &:hover {
        transform: scale(1.01);

        img {
          transform: scale(1.05);
        }
      }
    }
  }

  .post-info {
    height: 100%;
    width: 100%;
    padding: 20px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .post-meta {
    display: flex;
    justify-content: flex-end;
    margin: 4px 0;

    span {
      font-size: 14px;
      color: var(--grey-7);
      margin: 0 12px;
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
      display: flex;
      align-items: center;

      @media screen and (max-width: 767px) {
        margin: 0 8px;
      }
    }
  }

  .post-article {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    line-height: 32px;
    font-size: 15px;
    color: var(--grey-7);

    a {
      color: var(--color-link);
    }
  }

  .post-cover {
    width: 40%;
    position: relative;
    overflow: hidden;
    min-height: 95px;
    background-color: var(--color-wrap);
    flex-shrink: 0;
    pointer-events: none;

    @media screen and (max-width: 767px) {
      width: 100%;
      height: 45%;
    }

    @media screen and (min-width: 768px) {
      border-radius: 12px 0 0 12px;
      -webkit-clip-path: polygon(0 0, 92% 0%, 100% 100%, 0% 100%);
      clip-path: polygon(0 0, 92% 0%, 100% 100%, 0% 100%);

      &.right {
        border-radius: 0 12px 12px 0;
        -webkit-clip-path: polygon(0 0, 100% 0%, 100% 100%, 8% 100%);
        clip-path: polygon(0 0, 100% 0%, 100% 100%, 8% 100%);
      }
    }

    @media screen and (max-width: 767px) {
      border-radius: 12px 12px 0 0;

      &.right {
        border-radius: 12px 12px 0 0;
      }
    }

    img {
      display: block;
      transition: 0.2s;
      position: absolute;
      left: 0;
      top: 0;
      object-fit: cover;
      width: 100%;
      height: 100%;
    }
  }

  .post-title {
    padding: 20px 0;
    color: var(--color-link);
    font-size: 25px;
    letter-spacing: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.3s;
  }
</style>
