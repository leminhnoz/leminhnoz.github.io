// MathJax Config
window.MathJax = {
    AuthorInit: function () {
        MathJax.Hub.Config({
            tex2jax: {
                inlineMath: [ ['$','$'], ["\\(","\\)"] ],
                processEscapes: true
            }
        });
        MathJax.Hub.Register.StartupHook("End", function () {
            var elements = document.getElementsByClassName("math-content");

            for (var i = 0; i < elements.length; i++) {
                MathJax.Hub.Queue(["Typeset", MathJax.Hub, elements[i]]);
                
                // Set up a MutationObserver for each element
                var observer = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        if (mutation.type === "attributes") {
                            MathJax.Hub.Queue(["Typeset", MathJax.Hub, mutation.target]);
                        }
                    });
                });

                observer.observe(elements[i], {
                    attributes: true
                });
            }
        });
    }
};

// Language submission handling
function submmit_language(lang) {
    const currentLang = document.getElementById("language").value;
    if (lang != currentLang) {
        document.getElementById("language").value = lang;
        document.getElementById("set_language").submit();
    }
}
